generator client {
  provider               = "prisma-client"
  output                 = "../src/generated/prisma"
  moduleFormat           = "esm"
  generatedFileExtension = "ts"
  importFileExtension    = "ts"
}

datasource db {
  provider = "postgresql"
}

enum TenantStatus {
  ACTIVE
  SUSPENDED
  ARCHIVED
}

enum ConnectorStatus {
  ACTIVE
  DISABLED
  ERROR
}

enum CatalogSyncStatus {
  RUNNING
  SUCCEEDED
  FAILED
  BLOCKED
}

enum ChannelAccountStatus {
  ACTIVE
  DISABLED
}

enum OperatorRole {
  OWNER
  ADMIN
  OPERATOR
  VIEWER
}

enum ConsentStatus {
  UNKNOWN
  GRANTED
  REVOKED
}

enum ConversationState {
  BOT_ACTIVE
  WAITING_OPERATOR
  OPERATOR_ACTIVE
  CLOSED
}

enum MessageAuthorType {
  CUSTOMER
  BOT
  OPERATOR
  SYSTEM
}

enum MessageDirection {
  INBOUND
  OUTBOUND
}

enum MessageType {
  TEXT
  VOICE
  /// ADR 043: a public Instagram comment answered in private.
  COMMENT
}

/// ADR 043: what happened to a public Instagram comment.
enum InstagramCommentStatus {
  RECEIVED
  SKIPPED
  ANSWERED
  FAILED
}

/// ADR 042: a customer voice note waits for transcription.
enum VoiceStatus {
  PENDING
  TRANSCRIBED
  FAILED
}

enum DeliveryState {
  PENDING
  SENT
  FAILED
  UNKNOWN
}

enum CatalogItemStatus {
  ACTIVE
  INACTIVE
  DELETED
}

enum PricingBasis {
  PER_PERSON
  PER_NIGHT
  PER_UNIT
  TOTAL
  UNSPECIFIED
}

enum AvailabilityStatus {
  AVAILABLE
  LIMITED
  SOLD_OUT
  UNKNOWN
}

enum LeadStageKind {
  OPEN
  WON
  LOST
}

enum LeadStageSetBy {
  AGENT
  OPERATOR
}

enum PipelineAiStaging {
  OFF
  SUGGEST
  AUTO
}

enum LeadScore {
  HOT
  WARM
  COLD
}

enum LeadStatus {
  NEW
  IN_PROGRESS
  WON
  LOST
}

enum CrmSyncStatus {
  NOT_REQUIRED
  PENDING
  SYNCED
  FAILED
}

enum HandoverStatus {
  OPEN
  TAKEN
  RESOLVED
  CANCELLED
}

enum BookingStatus {
  REQUESTED
  CONFIRMED
  CANCELLED
  FAILED
}

enum InboundEventStatus {
  RECEIVED
  PROCESSING
  PROCESSED
  FAILED
}

enum OutboxEventStatus {
  PENDING
  PROCESSING
  SENT
  FAILED
}

/// Per channel account. OFF keeps the Phase 2 behavior; SHADOW runs the
/// agent and stores the draft without sending; LIVE sends (refused until an
/// operator handover notifier exists, except in local development).
enum AgentMode {
  OFF
  SHADOW
  LIVE
}

enum AgentTurnStatus {
  COMPUTING
  COMMITTED
  DISCARDED
  ABANDONED
  FAILED
}

enum HandoverNotificationStatus {
  PENDING
  SENT
  FAILED
}

enum AuditActorType {
  SYSTEM
  CUSTOMER
  OPERATOR
  ADMIN
}


enum CustomFieldEntity {
  PERSON
  LEAD
}

enum CustomFieldType {
  TEXT
  NUMBER
  DATE
  BOOLEAN
  SELECT
}

model Tenant {
  id                 String       @id @default(uuid(7)) @db.Uuid
  slug               String       @unique @db.VarChar(80)
  name               String       @db.VarChar(200)
  status             TenantStatus @default(ACTIVE)
  defaultLocale      String       @map("default_locale") @db.VarChar(32)
  supportedLocales   String[]     @map("supported_locales")
  timezone           String       @db.VarChar(64)
  packKey            String       @map("pack_key") @db.VarChar(100)
  packVersion        String       @map("pack_version") @db.VarChar(64)
  enabledCapabilities String[]    @default([]) @map("enabled_capabilities")
  retentionSettings Json         @default("{}") @map("retention_settings") @db.JsonB
  config             Json         @default("{}") @db.JsonB
  createdAt          DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt          DateTime     @updatedAt @map("updated_at") @db.Timestamptz(6)

  connectors      TenantConnector[]
  catalogSyncRuns CatalogSyncRun[]
  connectorRoles TenantConnectorRole[]
  llmUsage        LlmUsageRecord[]
  llmBudgetReservations LlmBudgetReservation[]
  internalNotes         InternalNote[]
  followUps             FollowUp[]
  knowledgeDocuments    KnowledgeDocument[]
  knowledgeChunks       KnowledgeChunk[]
  persons               Person[]
  personMerges          PersonMerge[]
  operatorApiTokens     OperatorApiToken[]
  operatorCredentials   OperatorCredential[]
  operatorSessions      OperatorSession[]
  inboxEvents           InboxEvent[]
  connectorOperations   ConnectorOperation[]
  actionProposals       ActionProposal[]
  shownOffers           ShownOffer[]
  channelAccounts ChannelAccount[]
  channelSecrets  ChannelSecret[]
  connectorSecrets ConnectorSecret[]
  operators       Operator[]
  contacts        Contact[]
  serviceTypes    ServiceType[]
  staffMembers    StaffMember[]
  availabilityRules AvailabilityRule[]
  availabilityExceptions AvailabilityException[]
  appointments    Appointment[]
  conversations  Conversation[]
  messages        Message[]
  instagramComments InstagramComment[]
  conversationSlots ConversationSlots[]
  agentTurns      AgentTurn[]
  catalogItems    CatalogItem[]
  offers          Offer[]
  aliases         CatalogAlias[]
  quotes          Quote[]
  leads           Lead[]
  leadStages      LeadStage[]
  pipelines       Pipeline[]
  sheetCatalogs   SheetCatalog[]
  handovers       Handover[]
  bookings        Booking[]
  inboundEvents   InboundEvent[]
  outboxEvents    OutboxEvent[]
  auditEvents     AuditEvent[]
  subscriptions        TenantSubscription[]
  subscriptionPayments SubscriptionPayment[]
  operatorInvites      OperatorInvite[]
  platformAuditEvents  PlatformAuditEvent[]
  mfaChallenges        MfaChallenge[]
  tags                 Tag[]
  personTags           PersonTag[]
  leadTags             LeadTag[]
  customFieldDefs      CustomFieldDef[]

  @@map("tenants")
}

model TenantConnector {
  id            String          @id @default(uuid(7)) @db.Uuid
  tenantId      String          @map("tenant_id") @db.Uuid
  connectorKey  String          @map("connector_key") @db.VarChar(100)
  status        ConnectorStatus @default(DISABLED)
  config        Json            @default("{}") @db.JsonB
  capabilities  String[]        @default([])
  secretRef     String?         @map("secret_ref") @db.VarChar(500)
  createdAt     DateTime        @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt     DateTime        @updatedAt @map("updated_at") @db.Timestamptz(6)
  tenant        Tenant          @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  syncRuns      CatalogSyncRun[]
  secrets       ConnectorSecret[]
  roles         TenantConnectorRole[]

  @@unique([tenantId, id])
  @@unique([tenantId, connectorKey])
  @@index([tenantId, status])
  @@map("tenant_connectors")
}

/// What a connector is used for (ADR 059).
enum ConnectorRole {
  CATALOG
  LEAD_SINK
  ACTIONS
}

/// Binds one connector to one role of a tenant (ADR 059). The primary key
/// allows at most one connector per role; deleting the connector unbinds it.
model TenantConnectorRole {
  tenantId          String          @map("tenant_id") @db.Uuid
  role              ConnectorRole
  tenantConnectorId String          @map("tenant_connector_id") @db.Uuid
  createdAt         DateTime        @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt         DateTime        @updatedAt @map("updated_at") @db.Timestamptz(6)
  tenant            Tenant          @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  connector         TenantConnector @relation(fields: [tenantId, tenantConnectorId], references: [tenantId, id], onDelete: Cascade)

  @@id([tenantId, role])
  @@index([tenantId, tenantConnectorId])
  @@map("tenant_connector_roles")
}

/// One catalog synchronisation attempt for a tenant connector. A partial
/// unique index (migration SQL) allows at most one RUNNING run per connector;
/// a run whose heartbeat goes stale is recovered as FAILED.
model CatalogSyncRun {
  id                String            @id @default(uuid(7)) @db.Uuid
  tenantId          String            @map("tenant_id") @db.Uuid
  tenantConnectorId String            @map("tenant_connector_id") @db.Uuid
  status            CatalogSyncStatus @default(RUNNING)
  sourceSystem      String?           @map("source_system") @db.VarChar(100)
  startedAt         DateTime          @default(now()) @map("started_at") @db.Timestamptz(6)
  heartbeatAt       DateTime          @default(now()) @map("heartbeat_at") @db.Timestamptz(6)
  finishedAt        DateTime?         @map("finished_at") @db.Timestamptz(6)
  itemsSeen         Int               @default(0) @map("items_seen")
  itemsUpserted     Int               @default(0) @map("items_upserted")
  itemsUnchanged    Int               @default(0) @map("items_unchanged")
  itemsDeactivated  Int               @default(0) @map("items_deactivated")
  offersSeen        Int               @default(0) @map("offers_seen")
  offersUpserted    Int               @default(0) @map("offers_upserted")
  offersUnchanged   Int               @default(0) @map("offers_unchanged")
  offersDeactivated Int               @default(0) @map("offers_deactivated")
  errorCode         String?           @map("error_code") @db.VarChar(100)
  errorCategory     String?           @map("error_category") @db.VarChar(40)
  createdAt         DateTime          @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt         DateTime          @updatedAt @map("updated_at") @db.Timestamptz(6)
  tenant            Tenant            @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  connector         TenantConnector   @relation(fields: [tenantId, tenantConnectorId], references: [tenantId, id], onDelete: Cascade)

  @@unique([tenantId, id])
  @@index([tenantId, tenantConnectorId, startedAt])
  @@index([status, heartbeatAt])
  @@map("catalog_sync_runs")
}

/// One provider request made by the agent, for cost accounting. Holds token
/// counts and cost only: no prompts, responses or customer text. Idempotent
/// on the provider response id, so re-recording a response cannot double
/// count; a retried turn makes new (billed) requests with new ids. There is
/// deliberately no FK to conversations, so cost history survives a privacy
/// deletion of conversation content.
model LlmUsageRecord {
  id                 String   @id @default(uuid(7)) @db.Uuid
  tenantId           String   @map("tenant_id") @db.Uuid
  conversationId     String?  @map("conversation_id") @db.Uuid
  turnKey            String   @map("turn_key") @db.VarChar(200)
  callIndex          Int      @map("call_index")
  purpose            String   @db.VarChar(20)
  tier               String   @db.VarChar(10)
  provider           String   @db.VarChar(40)
  model              String   @db.VarChar(100)
  responseId         String   @map("response_id") @db.VarChar(200)
  inputTokens        Int      @map("input_tokens")
  outputTokens       Int      @map("output_tokens")
  cacheReadTokens    Int      @map("cache_read_tokens")
  cacheWrite5mTokens Int      @map("cache_write_5m_tokens")
  cacheWrite1hTokens Int      @map("cache_write_1h_tokens")
  reasoningTokens    Int?     @map("reasoning_tokens")
  /// True when the provider reported no usage and counts were estimated.
  usageEstimated     Boolean  @default(false) @map("usage_estimated")
  costNano           BigInt   @map("cost_nano_usd")
  reservedNano       BigInt   @map("reserved_nano_usd")
  pricingVersion     String   @map("pricing_version") @db.VarChar(64)
  durationMs         Int      @map("duration_ms")
  attempts           Int
  outcome            String   @db.VarChar(40)
  createdAt          DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  tenant             Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, id])
  @@unique([tenantId, provider, responseId])
  @@index([tenantId, conversationId])
  @@index([tenantId, createdAt])
  @@map("llm_usage_records")
}

/// One attempt to answer a batch of inbound messages (claim -> compute ->
/// commit). The agent runs outside any transaction; only the claim and the
/// commit are short transactions. Partial unique indexes (migration SQL)
/// allow one COMPUTING turn per conversation and one COMMITTED turn per
/// idempotency key. Holds counts, cost, redacted tool summaries, guardrail
/// results and the draft reply; no raw customer text or prompts.
model AgentTurn {
  id                  String          @id @default(uuid(7)) @db.Uuid
  tenantId            String          @map("tenant_id") @db.Uuid
  conversationId      String          @map("conversation_id") @db.Uuid
  channelAccountId    String          @map("channel_account_id") @db.Uuid
  /// agent-reply:<conversationId>:<answeredSequence>
  idempotencyKey      String          @map("idempotency_key") @db.VarChar(200)
  attempt             Int
  mode                AgentMode
  status              AgentTurnStatus @default(COMPUTING)
  /// Outbox event id of the job that owns this attempt.
  claimToken          String          @map("claim_token") @db.VarChar(200)
  leaseExpiresAt      DateTime        @map("lease_expires_at") @db.Timestamptz(6)
  answeredSequence    Int             @map("answered_sequence")
  /// Highest inbound sequence in the conversation at claim time; a message
  /// above it at commit arrived during compute and supersedes this reply.
  seenInboundSequence Int             @default(0) @map("seen_inbound_sequence")
  conversationVersion Int             @map("conversation_version")
  inboundEventIds     String[]        @map("inbound_event_ids")
  correlationId       String          @map("correlation_id") @db.VarChar(100)
  outcome             String?         @db.VarChar(40)
  handoverReason      String?         @map("handover_reason") @db.VarChar(100)
  discardReason       String?         @map("discard_reason") @db.VarChar(40)
  failureCode         String?         @map("failure_code") @db.VarChar(100)
  locale              String?         @db.VarChar(16)
  provider            String?         @db.VarChar(40)
  models              String[]        @default([])
  llmCalls            Int             @default(0) @map("llm_calls")
  inputTokens         Int             @default(0) @map("input_tokens")
  outputTokens        Int             @default(0) @map("output_tokens")
  estimatedCostNano   BigInt          @default(0) @map("estimated_cost_nano_usd")
  actualCostNano      BigInt          @default(0) @map("actual_cost_nano_usd")
  latencyMs           Int?            @map("latency_ms")
  toolCalls           Json            @default("[]") @map("tool_calls") @db.JsonB
  guardrail           Json            @default("{}") @db.JsonB
  facts               Json            @default("[]") @db.JsonB
  /// Fact ids (F1..) that appear in the final reply, for offers-shown tracking.
  shownFactIds        Json            @default("[]") @map("shown_fact_ids") @db.JsonB
  /// Progress signals for the STUCK trigger (no raw customer text).
  askedSlot           String?         @map("asked_slot") @db.VarChar(100)
  slotsFilled         Int?            @map("slots_filled")
  textFingerprint     String?         @map("text_fingerprint") @db.VarChar(64)
  draftText           String?         @map("draft_text") @db.Text
  replyMessageId      String?         @map("reply_message_id") @db.Uuid
  handoverId          String?         @map("handover_id") @db.Uuid
  pricingVersion      String?         @map("pricing_version") @db.VarChar(64)
  promptVersion       String?         @map("prompt_version") @db.VarChar(64)
  packRef             String?         @map("pack_ref") @db.VarChar(170)
  startedAt           DateTime        @default(now()) @map("started_at") @db.Timestamptz(6)
  completedAt         DateTime?       @map("completed_at") @db.Timestamptz(6)
  createdAt           DateTime        @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt           DateTime        @updatedAt @map("updated_at") @db.Timestamptz(6)
  tenant              Tenant          @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  conversation        Conversation    @relation(fields: [tenantId, conversationId], references: [tenantId, id], onDelete: Cascade)
  channelAccount      ChannelAccount  @relation(fields: [tenantId, channelAccountId], references: [tenantId, id], onDelete: Restrict)

  @@unique([tenantId, id])
  @@unique([tenantId, idempotencyKey, attempt])
  @@index([tenantId, conversationId, status])
  @@index([status, leaseExpiresAt])
  @@map("agent_turns")
}

model ChannelAccount {
  id                String              @id @default(uuid(7)) @db.Uuid
  tenantId          String              @map("tenant_id") @db.Uuid
  channelType       String              @map("channel_type") @db.VarChar(40)
  externalAccountId String              @map("external_account_id") @db.VarChar(200)
  status            ChannelAccountStatus @default(DISABLED)
  /// Shown name of the connected account (for Telegram: the bot's @username).
  displayName       String?             @map("display_name") @db.VarChar(200)
  credentialRef     String?             @map("credential_ref") @db.VarChar(500)
  webhookSecretRef  String?             @map("webhook_secret_ref") @db.VarChar(500)
  agentMode         AgentMode           @default(OFF) @map("agent_mode")
  /// A developer/test bot that only receives fake or seed data. Untrusted
  /// LLM providers may run in SHADOW only on such accounts unless
  /// LLM_ALLOW_REAL_CUSTOMER_DATA=true.
  isTestAccount     Boolean             @default(false) @map("is_test_account")
  /// Telegram chat (operator group) where handovers for this bot are posted.
  operatorChatId    String?             @map("operator_chat_id") @db.VarChar(200)
  createdAt         DateTime            @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt         DateTime            @updatedAt @map("updated_at") @db.Timestamptz(6)
  tenant            Tenant              @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  contacts     Contact[]
  conversations Conversation[]
  messages     Message[]
  instagramComments InstagramComment[]
  inboundEvents InboundEvent[]
  agentTurns   AgentTurn[]
  secrets      ChannelSecret[]

  @@unique([tenantId, id])
  // Provider routing resolves the tenant from this globally unique account key.
  @@unique([channelType, externalAccountId])
  @@index([tenantId, status])
  @@map("channel_accounts")
}

/// Encrypted secret of one channel account (ADR 028): bot token, webhook
/// secret. AES-256-GCM; the associated data binds the value to tenant,
/// account and purpose. Only ciphertext is stored; the key is never in the
/// database. Read and written through ChannelSecretStore only.
/// Encrypted per-connector secrets (ADR 032), e.g. a Bitrix24 incoming-webhook
/// URL. Same cipher as channel secrets, own table and associated data.
model ConnectorSecret {
  id                String          @id @default(uuid(7)) @db.Uuid
  tenantId          String          @map("tenant_id") @db.Uuid
  tenantConnectorId String          @map("tenant_connector_id") @db.Uuid
  purpose           String          @db.VarChar(40)
  keyId             String          @map("key_id") @db.VarChar(40)
  nonce             Bytes
  /// Ciphertext followed by the 16-byte GCM tag.
  ciphertext        Bytes
  createdAt         DateTime        @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt         DateTime        @updatedAt @map("updated_at") @db.Timestamptz(6)
  tenant            Tenant          @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  tenantConnector   TenantConnector @relation(fields: [tenantId, tenantConnectorId], references: [tenantId, id], onDelete: Cascade)

  @@unique([tenantId, tenantConnectorId, purpose])
  @@map("connector_secrets")
}

model ChannelSecret {
  id               String         @id @default(uuid(7)) @db.Uuid
  tenantId         String         @map("tenant_id") @db.Uuid
  channelAccountId String         @map("channel_account_id") @db.Uuid
  purpose          String         @db.VarChar(40)
  keyId            String         @map("key_id") @db.VarChar(40)
  nonce            Bytes
  /// Ciphertext followed by the 16-byte GCM tag.
  ciphertext       Bytes
  createdAt        DateTime       @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt        DateTime       @updatedAt @map("updated_at") @db.Timestamptz(6)
  tenant           Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  channelAccount   ChannelAccount @relation(fields: [tenantId, channelAccountId], references: [tenantId, id], onDelete: Cascade)

  @@unique([tenantId, channelAccountId, purpose])
  @@map("channel_secrets")
}

model Operator {
  id          String       @id @default(uuid(7)) @db.Uuid
  tenantId    String       @map("tenant_id") @db.Uuid
  displayName String       @map("display_name") @db.VarChar(160)
  role        OperatorRole @default(OPERATOR)
  telegramUserId String?   @map("telegram_user_id") @db.VarChar(100)
  isActive    Boolean      @default(true) @map("is_active")
  createdAt   DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime     @updatedAt @map("updated_at") @db.Timestamptz(6)
  tenant      Tenant       @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  apiTokens             OperatorApiToken[]
  credentials           OperatorCredential[] // at most one: operator_id is unique
  sessions              OperatorSession[]
  assignedConversations Conversation[] @relation("AssignedOperator")
  assignedHandovers     Handover[]     @relation("AssignedHandoverOperator")
  personMerges          PersonMerge[]  @relation("PersonMergeBy")
  personUnmerges        PersonMerge[]  @relation("PersonMergeUndoneBy")
  ownedLeads            Lead[]         @relation("LeadOwner")

  @@unique([tenantId, id])
  @@unique([tenantId, telegramUserId])
  @@index([tenantId, isActive])
  @@map("operators")
}

model Contact {
  id                String        @id @default(uuid(7)) @db.Uuid
  tenantId          String        @map("tenant_id") @db.Uuid
  channelAccountId  String        @map("channel_account_id") @db.Uuid
  providerUserId    String        @map("provider_user_id") @db.VarChar(200)
  name              String?       @db.VarChar(200)
  phone             String?       @db.VarChar(40)
  language          String?       @db.VarChar(16)
  script            String?       @db.VarChar(16)
  consentStatus     ConsentStatus @default(UNKNOWN) @map("consent_status")
  consentAt         DateTime?     @map("consent_at") @db.Timestamptz(6)
  marketingOptOut   Boolean       @default(false) @map("marketing_opt_out")
  deletedAt         DateTime?     @map("deleted_at") @db.Timestamptz(6)
  createdAt         DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt         DateTime      @updatedAt @map("updated_at") @db.Timestamptz(6)
  tenant            Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  channelAccount    ChannelAccount @relation(fields: [tenantId, channelAccountId], references: [tenantId, id], onDelete: Restrict)
  personId          String?       @map("person_id") @db.Uuid
  person            Person?       @relation(fields: [tenantId, personId], references: [tenantId, id], onDelete: Restrict)

  conversations Conversation[]
  leads         Lead[]
  bookings      Booking[]
  appointments  Appointment[]

  @@unique([tenantId, id])
  @@unique([tenantId, channelAccountId, providerUserId])
  @@index([tenantId, phone])
  @@index([tenantId, personId])
  @@map("contacts")
}

/// ADR 052: customer identity above the per-channel Contact. Slice A keeps it 1:1.
model Person {
  id            String    @id @default(uuid(7)) @db.Uuid
  tenantId      String    @map("tenant_id") @db.Uuid
  displayName   String?   @map("display_name") @db.VarChar(200)
  primaryPhone  String?   @map("primary_phone") @db.VarChar(40)
  mergedIntoId  String?   @map("merged_into_id") @db.Uuid
  deletedAt     DateTime? @map("deleted_at") @db.Timestamptz(6)
  /// ADR 053: tenant-validated custom field values (key -> value), personal data.
  customFields  Json      @default("{}") @map("custom_fields") @db.JsonB
  createdAt     DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt     DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)
  tenant        Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  mergedInto    Person?   @relation("PersonMerge", fields: [tenantId, mergedIntoId], references: [tenantId, id], onDelete: Restrict)
  mergedFrom    Person[]  @relation("PersonMerge")

  contacts Contact[]
  mergesAsSurvivor PersonMerge[] @relation("PersonMergeSurvivor")
  mergesAsMerged   PersonMerge[] @relation("PersonMergeMerged")
  tags PersonTag[]

  @@unique([tenantId, id])
  @@index([tenantId, primaryPhone])
  @@index([tenantId, mergedIntoId])
  @@map("persons")
}

/// Audit and undo record of a person merge (ADR 052 slice C).
model PersonMerge {
  id                 String    @id @default(uuid(7)) @db.Uuid
  tenantId           String    @map("tenant_id") @db.Uuid
  survivorId         String    @map("survivor_id") @db.Uuid
  mergedId           String    @map("merged_id") @db.Uuid
  contactIds         String[]  @map("contact_ids") @db.Uuid
  byOperatorId       String    @map("by_operator_id") @db.Uuid
  reason             String    @db.VarChar(500)
  /// ADR 053: reversible carry-over { tagIds: string[], fields: Record<string, unknown> }.
  carried            Json?     @db.JsonB
  createdAt          DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  undoneAt           DateTime? @map("undone_at") @db.Timestamptz(6)
  undoneByOperatorId String?   @map("undone_by_operator_id") @db.Uuid
  tenant             Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  survivor           Person    @relation("PersonMergeSurvivor", fields: [tenantId, survivorId], references: [tenantId, id], onDelete: Restrict)
  merged             Person    @relation("PersonMergeMerged", fields: [tenantId, mergedId], references: [tenantId, id], onDelete: Restrict)
  byOperator         Operator  @relation("PersonMergeBy", fields: [tenantId, byOperatorId], references: [tenantId, id], onDelete: Restrict)
  undoneByOperator   Operator? @relation("PersonMergeUndoneBy", fields: [tenantId, undoneByOperatorId], references: [tenantId, id], onDelete: Restrict)

  @@index([tenantId, survivorId, createdAt])
  @@map("person_merges")
}

model Conversation {
  id                  String           @id @default(uuid(7)) @db.Uuid
  tenantId            String           @map("tenant_id") @db.Uuid
  channelAccountId    String           @map("channel_account_id") @db.Uuid
  contactId           String           @map("contact_id") @db.Uuid
  providerChatId      String           @map("provider_chat_id") @db.VarChar(200)
  state               ConversationState @default(BOT_ACTIVE)
  version             Int              @default(1)
  assignedOperatorId  String?          @map("assigned_operator_id") @db.Uuid
  language            String?          @db.VarChar(16)
  script              String?          @db.VarChar(16)
  lastInboundAt       DateTime?        @map("last_inbound_at") @db.Timestamptz(6)
  createdAt           DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt           DateTime         @updatedAt @map("updated_at") @db.Timestamptz(6)
  tenant              Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  channelAccount      ChannelAccount   @relation(fields: [tenantId, channelAccountId], references: [tenantId, id], onDelete: Restrict)
  contact             Contact          @relation(fields: [tenantId, contactId], references: [tenantId, id], onDelete: Restrict)
  assignedOperator    Operator?        @relation("AssignedOperator", fields: [tenantId, assignedOperatorId], references: [tenantId, id], onDelete: Restrict)

  messages Message[]

  instagramComments InstagramComment[]
  notes    InternalNote[]
  followUps FollowUp[]
  shownOffers ShownOffer[]
  slots    ConversationSlots[]
  quotes   Quote[]
  leads    Lead[]
  handovers Handover[]
  agentTurns AgentTurn[]
  actionProposals ActionProposal[]
  appointments Appointment[]

  @@unique([tenantId, id])
  @@unique([tenantId, channelAccountId, providerChatId])
  @@index([tenantId, state, updatedAt])
  @@index([tenantId, contactId])
  @@index([tenantId, assignedOperatorId])
  @@map("conversations")
}

model Message {
  id                   String           @id @default(uuid(7)) @db.Uuid
  tenantId             String           @map("tenant_id") @db.Uuid
  conversationId       String           @map("conversation_id") @db.Uuid
  channelAccountId     String           @map("channel_account_id") @db.Uuid
  authorType           MessageAuthorType @map("author_type")
  direction            MessageDirection
  type                 MessageType       @default(TEXT)
  text                 String            @db.Text
  sequence             Int
  providerChatId       String            @map("provider_chat_id") @db.VarChar(200)
  providerMessageId    String?           @map("provider_message_id") @db.VarChar(200)
  deliveryState        DeliveryState     @default(UNKNOWN) @map("delivery_state")
  deliveryAttempts     Int               @default(0) @map("delivery_attempts")
  deliveryErrorCode    String?           @map("delivery_error_code") @db.VarChar(100)
  sendIdempotencyKey   String?           @map("send_idempotency_key") @db.VarChar(200)
  detectedLanguage     String?           @map("detected_language") @db.VarChar(16)
  detectedScript       String?           @map("detected_script") @db.VarChar(16)
  languageConfidence   Decimal?          @map("language_confidence") @db.Decimal(4, 3)
  /// ADR 042: voice notes. The provider's media reference (Telegram file_id,
  /// Meta attachment URL), never the audio itself; the transcript is `text`.
  voiceStatus          VoiceStatus?      @map("voice_status")
  mediaRef             String?           @map("media_ref") @db.VarChar(2048)
  mediaMimeType        String?           @map("media_mime_type") @db.VarChar(100)
  mediaDurationSeconds Int?              @map("media_duration_seconds")
  /// ADR 044: code-built rich content sent after the text (the Instagram
  /// carousel spec); never model output, never customer input.
  richContent          Json?             @map("rich_content")
  createdAt            DateTime           @default(now()) @map("created_at") @db.Timestamptz(6)
  tenant               Tenant             @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  conversation         Conversation       @relation(fields: [tenantId, conversationId], references: [tenantId, id], onDelete: Cascade)
  channelAccount       ChannelAccount     @relation(fields: [tenantId, channelAccountId], references: [tenantId, id], onDelete: Restrict)

  shownQuotes Quote[] @relation("QuoteShownInMessage")

  @@unique([tenantId, id])
  @@unique([tenantId, conversationId, sequence])
  @@index([tenantId, conversationId, createdAt])
  @@index([tenantId, channelAccountId, providerMessageId])
  @@index([tenantId, sendIdempotencyKey])
  @@map("messages")
}

model ConversationSlots {
  id             String       @id @default(uuid(7)) @db.Uuid
  tenantId       String       @map("tenant_id") @db.Uuid
  conversationId String       @map("conversation_id") @db.Uuid
  version        Int
  slots          Json         @db.JsonB
  createdAt      DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)
  tenant         Tenant       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  conversation   Conversation @relation(fields: [tenantId, conversationId], references: [tenantId, id], onDelete: Cascade)

  @@unique([tenantId, id])
  @@unique([tenantId, conversationId, version])
  @@index([tenantId, conversationId])
  @@map("conversation_slots")
}

model CatalogItem {
  id               String           @id @default(uuid(7)) @db.Uuid
  tenantId         String           @map("tenant_id") @db.Uuid
  sourceSystem     String           @map("source_system") @db.VarChar(100)
  sourceEntityId   String           @map("source_entity_id") @db.VarChar(200)
  itemType         String           @map("item_type") @db.VarChar(100)
  title            String           @db.VarChar(500)
  normalizedTitle  String           @map("normalized_title") @db.VarChar(600)
  normalizerVersion Int             @default(1) @map("normalizer_version")
  description      String?          @db.Text
  attributes       Json             @default("{\"fields\":{}}") @db.JsonB
  syncedAt         DateTime         @map("synced_at") @db.Timestamptz(6)
  sourceHash       String           @map("source_hash") @db.VarChar(128)
  status           CatalogItemStatus @default(ACTIVE)
  deletedAt        DateTime?        @map("deleted_at") @db.Timestamptz(6)
  createdAt        DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt        DateTime         @updatedAt @map("updated_at") @db.Timestamptz(6)
  tenant           Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  offers  Offer[]
  aliases CatalogAlias[]

  @@unique([tenantId, id])
  @@unique([tenantId, sourceSystem, sourceEntityId])
  @@index([tenantId, status, normalizedTitle])
  @@map("catalog_items")
}

model Offer {
  id                String             @id @default(uuid(7)) @db.Uuid
  tenantId          String             @map("tenant_id") @db.Uuid
  itemId            String             @map("item_id") @db.Uuid
  sourceSystem      String             @map("source_system") @db.VarChar(100)
  sourceEntityId    String             @map("source_entity_id") @db.VarChar(200)
  price             Decimal?           @db.Decimal(20, 6)
  currency          String?            @db.Char(3)
  pricingBasis      PricingBasis        @default(UNSPECIFIED) @map("pricing_basis")
  taxesIncluded     Boolean?           @map("taxes_included")
  feesIncluded      Boolean?           @map("fees_included")
  availabilityStatus AvailabilityStatus @default(UNKNOWN) @map("availability_status")
  seatsLeft         Int?               @map("seats_left")
  startsAt          DateTime?          @map("starts_at") @db.Timestamptz(6)
  endsAt            DateTime?          @map("ends_at") @db.Timestamptz(6)
  validFrom         DateTime?          @map("valid_from") @db.Timestamptz(6)
  validUntil        DateTime?          @map("valid_until") @db.Timestamptz(6)
  attributes        Json               @default("{\"fields\":{}}") @db.JsonB
  syncedAt          DateTime           @map("synced_at") @db.Timestamptz(6)
  sourceHash        String             @map("source_hash") @db.VarChar(128)
  deletedAt         DateTime?          @map("deleted_at") @db.Timestamptz(6)
  createdAt         DateTime           @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt         DateTime           @updatedAt @map("updated_at") @db.Timestamptz(6)
  tenant            Tenant             @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  item              CatalogItem        @relation(fields: [tenantId, itemId], references: [tenantId, id], onDelete: Cascade)

  quotes   Quote[]
  bookings Booking[]

  @@unique([tenantId, id])
  @@unique([tenantId, sourceSystem, sourceEntityId])
  @@index([tenantId, itemId, availabilityStatus])
  @@index([tenantId, validUntil])
  @@map("offers")
}

model CatalogAlias {
  id                String      @id @default(uuid(7)) @db.Uuid
  tenantId          String      @map("tenant_id") @db.Uuid
  itemId            String      @map("item_id") @db.Uuid
  value             String      @db.VarChar(500)
  normalizedValue   String      @map("normalized_value") @db.VarChar(600)
  normalizerVersion Int         @default(1) @map("normalizer_version")
  locale            String      @db.VarChar(32)
  script            String      @db.VarChar(16)
  createdAt         DateTime    @default(now()) @map("created_at") @db.Timestamptz(6)
  tenant            Tenant      @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  item              CatalogItem @relation(fields: [tenantId, itemId], references: [tenantId, id], onDelete: Cascade)

  @@unique([tenantId, id])
  @@unique([tenantId, itemId, normalizedValue, locale, script])
  @@index([tenantId, normalizedValue])
  @@map("catalog_aliases")
}

model Quote {
  id                String       @id @default(uuid(7)) @db.Uuid
  tenantId          String       @map("tenant_id") @db.Uuid
  offerId           String       @map("offer_id") @db.Uuid
  conversationId    String       @map("conversation_id") @db.Uuid
  amount            Decimal      @db.Decimal(20, 6)
  currency          String       @db.Char(3)
  pricingBasis      PricingBasis @map("pricing_basis")
  breakdown         Json         @db.JsonB
  sourceSystem      String       @map("source_system") @db.VarChar(100)
  sourceEntityId    String       @map("source_entity_id") @db.VarChar(200)
  retrievedAt       DateTime     @map("retrieved_at") @db.Timestamptz(6)
  validUntil        DateTime?    @map("valid_until") @db.Timestamptz(6)
  snapshot          Json         @db.JsonB
  shownInMessageId  String?      @map("shown_in_message_id") @db.Uuid
  createdAt         DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)
  tenant            Tenant       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  offer             Offer        @relation(fields: [tenantId, offerId], references: [tenantId, id], onDelete: Restrict)
  conversation      Conversation @relation(fields: [tenantId, conversationId], references: [tenantId, id], onDelete: Cascade)
  shownInMessage    Message?     @relation("QuoteShownInMessage", fields: [tenantId, shownInMessageId], references: [tenantId, id], onDelete: Restrict)

  @@unique([tenantId, id])
  @@unique([tenantId, shownInMessageId, offerId])
  @@index([tenantId, conversationId, createdAt])
  @@index([tenantId, validUntil])
  @@index([tenantId, offerId])
  @@map("quotes")
}

model Lead {
  id              String       @id @default(uuid(7)) @db.Uuid
  tenantId        String       @map("tenant_id") @db.Uuid
  contactId       String       @map("contact_id") @db.Uuid
  conversationId  String       @map("conversation_id") @db.Uuid
  /// ADR 057: the lead's pipeline. A BEFORE INSERT trigger fills the nil
  /// default with the stage's pipeline or the tenant's default pipeline.
  pipelineId      String       @default(dbgenerated("'00000000-0000-0000-0000-000000000000'::uuid")) @map("pipeline_id") @db.Uuid
  pipelineStageId String?      @map("pipeline_stage_id") @db.Uuid
  /// ADR 057 opportunity fields (operator data, never shown as a fact).
  ownerOperatorId String?      @map("owner_operator_id") @db.Uuid
  amount          Decimal?     @db.Decimal(14, 2)
  currency        String?      @db.Char(3)
  source          String?      @db.VarChar(60)
  expectedCloseDate DateTime?  @map("expected_close_date") @db.Date
  lostReason      String?      @map("lost_reason") @db.VarChar(200)
  /// ADR 058: who last set the stage; an OPERATOR lock stops agent staging.
  stageSetBy      LeadStageSetBy @default(AGENT) @map("stage_set_by")
  stageSetAt      DateTime?    @map("stage_set_at") @db.Timestamptz(6)
  /// ADR 058 SUGGEST mode: the agent's proposal, never a fact.
  suggestedStageId String?     @map("suggested_stage_id") @db.Uuid
  suggestedReasonCodes String[] @default([]) @map("suggested_reason_codes")
  score           LeadScore    @default(COLD)
  /// Set by an operator: automatic rescoring keeps it until the operator
  /// returns the lead to automatic scoring.
  scoreSetByOperator Boolean @default(false) @map("score_set_by_operator")
  reasonCodes     String[]     @default([]) @map("reason_codes")
  summary         String       @db.Text
  status          LeadStatus   @default(NEW)
  /// Collected requirements (slot key -> value) at the last update.
  requirements    Json         @default("{}") @db.JsonB
  /// ADR 053: tenant-validated custom field values (key -> value).
  customFields    Json         @default("{}") @map("custom_fields") @db.JsonB
  nextAttemptAt   DateTime?    @map("next_attempt_at") @db.Timestamptz(6)
  crmSyncStatus   CrmSyncStatus @default(PENDING) @map("crm_sync_status")
  crmLeadId       String?      @map("crm_lead_id") @db.VarChar(200)
  attempts        Int          @default(0)
  lastErrorCode   String?      @map("last_error_code") @db.VarChar(100)
  idempotencyKey  String       @map("idempotency_key") @db.VarChar(200)
  createdAt       DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime     @updatedAt @map("updated_at") @db.Timestamptz(6)
  /// ADR 062: set = archived (hidden everywhere, reversible); deleted for good from there.
  archivedAt      DateTime?    @map("archived_at") @db.Timestamptz(6)
  tenant          Tenant       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  contact         Contact      @relation(fields: [tenantId, contactId], references: [tenantId, id], onDelete: Restrict)
  conversation    Conversation @relation(fields: [tenantId, conversationId], references: [tenantId, id], onDelete: Restrict)
  pipeline        Pipeline     @relation(fields: [tenantId, pipelineId], references: [tenantId, id], onDelete: Restrict)
  pipelineStage   LeadStage?   @relation(fields: [tenantId, pipelineId, pipelineStageId], references: [tenantId, pipelineId, id], onDelete: Restrict)
  suggestedStage  LeadStage?   @relation("LeadSuggestedStage", fields: [tenantId, suggestedStageId], references: [tenantId, id], onDelete: Restrict)
  owner           Operator?    @relation("LeadOwner", fields: [tenantId, ownerOperatorId], references: [tenantId, id], onDelete: Restrict)
  tags            LeadTag[]

  @@unique([tenantId, id])
  @@unique([tenantId, idempotencyKey])
  @@index([tenantId, status, score])
  @@index([tenantId, pipelineStageId, createdAt])
  @@index([tenantId, pipelineId, createdAt])
  @@index([tenantId, ownerOperatorId])
  @@index([tenantId, crmSyncStatus, updatedAt])
  @@index([tenantId, contactId])
  @@index([tenantId, conversationId])
  @@index([tenantId, archivedAt])
  @@map("leads")
}

/// ADR 057: a tenant's lead pipeline. The default pipeline's name is null
/// (localised by the web); exactly one active default per tenant (partial
/// unique index in migration SQL).
model Pipeline {
  id         String    @id @default(uuid(7)) @db.Uuid
  tenantId   String    @map("tenant_id") @db.Uuid
  name       String?   @db.VarChar(80)
  position   Int       @default(0)
  isDefault  Boolean   @default(false) @map("is_default")
  createdAt  DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  archivedAt DateTime? @map("archived_at") @db.Timestamptz(6)
  /// ADR 058: OFF for existing pipelines; the application creates new ones as AUTO.
  aiStaging  PipelineAiStaging @default(OFF) @map("ai_staging")
  tenant     Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  stages     LeadStage[]
  leads      Lead[]

  @@unique([tenantId, id])
  // One active default per tenant: partial unique index (SQL only).
  @@index([tenantId, archivedAt, position])
  @@map("pipelines")
}

model LeadStage {
  id        String   @id @default(uuid(7)) @db.Uuid
  tenantId  String   @map("tenant_id") @db.Uuid
  pipelineId String  @map("pipeline_id") @db.Uuid
  archivedAt DateTime? @map("archived_at") @db.Timestamptz(6)
  code      String?  @db.VarChar(40)
  name      String?  @db.VarChar(80)
  /// ADR 058: OPEN stages are the funnel; WON and LOST are the closed columns.
  kind      LeadStageKind @default(OPEN)
  position  Int      @default(0)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)
  tenant    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  pipeline  Pipeline @relation(fields: [tenantId, pipelineId], references: [tenantId, id], onDelete: Restrict)
  leads     Lead[]
  suggestedFor Lead[] @relation("LeadSuggestedStage")

  @@unique([tenantId, id])
  @@unique([tenantId, pipelineId, id])
  @@unique([tenantId, pipelineId, code])
  @@index([tenantId, pipelineId, position])
  @@map("lead_stages")
}

model Handover {
  id                 String         @id @default(uuid(7)) @db.Uuid
  tenantId           String         @map("tenant_id") @db.Uuid
  conversationId     String         @map("conversation_id") @db.Uuid
  reasonCode         String         @map("reason_code") @db.VarChar(100)
  status             HandoverStatus @default(OPEN)
  /// Delivery to operators is Phase 5; until then handovers stay PENDING.
  notificationStatus HandoverNotificationStatus @default(PENDING) @map("notification_status")
  idempotencyKey     String?        @map("idempotency_key") @db.VarChar(200)
  summary            Json           @db.JsonB
  assignedOperatorId String?        @map("assigned_operator_id") @db.Uuid
  version            Int            @default(1)
  /// Where the operator card was posted; replies to it are routed back here.
  operatorChatId     String?        @map("operator_chat_id") @db.VarChar(200)
  operatorMessageId  String?        @map("operator_message_id") @db.VarChar(100)
  notifiedAt         DateTime?      @map("notified_at") @db.Timestamptz(6)
  notificationErrorCode String?     @map("notification_error_code") @db.VarChar(100)
  slaDueAt           DateTime?      @map("sla_due_at") @db.Timestamptz(6)
  slaAlertedAt       DateTime?      @map("sla_alerted_at") @db.Timestamptz(6)
  customerNoticeAt   DateTime?      @map("customer_notice_at") @db.Timestamptz(6)
  openedAt           DateTime       @default(now()) @map("opened_at") @db.Timestamptz(6)
  takenAt            DateTime?      @map("taken_at") @db.Timestamptz(6)
  resolvedAt         DateTime?      @map("resolved_at") @db.Timestamptz(6)
  tenant             Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  conversation       Conversation   @relation(fields: [tenantId, conversationId], references: [tenantId, id], onDelete: Cascade)
  assignedOperator   Operator?      @relation("AssignedHandoverOperator", fields: [tenantId, assignedOperatorId], references: [tenantId, id], onDelete: Restrict)

  @@unique([tenantId, id])
  @@unique([tenantId, idempotencyKey])
  @@unique([tenantId, operatorChatId, operatorMessageId])
  @@index([tenantId, status, openedAt])
  @@index([tenantId, notificationStatus])
  @@index([status, slaDueAt])
  @@map("handovers")
}

model Booking {
  id                   String        @id @default(uuid(7)) @db.Uuid
  tenantId             String        @map("tenant_id") @db.Uuid
  offerId              String        @map("offer_id") @db.Uuid
