  createdAt            DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt            DateTime      @updatedAt @map("updated_at") @db.Timestamptz(6)
  tenant               Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  offer                Offer         @relation(fields: [tenantId, offerId], references: [tenantId, id], onDelete: Restrict)
  contact              Contact       @relation(fields: [tenantId, contactId], references: [tenantId, id], onDelete: Restrict)

  @@unique([tenantId, id])
  @@unique([tenantId, idempotencyKey])
  @@index([tenantId, status, createdAt])
  @@index([tenantId, offerId])
  @@index([tenantId, contactId])
  @@map("bookings")
}

model InboundEvent {
  id               String            @id @default(uuid(7)) @db.Uuid
  tenantId         String            @map("tenant_id") @db.Uuid
  channelAccountId String            @map("channel_account_id") @db.Uuid
  providerEventId  String            @map("provider_event_id") @db.VarChar(200)
  redactedPayload  Json              @map("redacted_payload") @db.JsonB
  status           InboundEventStatus @default(RECEIVED)
  receivedAt       DateTime          @default(now()) @map("received_at") @db.Timestamptz(6)
