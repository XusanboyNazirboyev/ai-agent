generator client {
  provider               = "prisma-client"
  output                 = "../src/generated/prisma"
  moduleFormat           = "esm"
  generatedFileExtension = "ts"
  importFileExtension    = "ts"
}

datasource db {
  provider = "postgresql"
}

enum TenantStatus {
  ACTIVE
  SUSPENDED
  ARCHIVED
}

enum ConnectorStatus {
  ACTIVE
  DISABLED
  ERROR
}

enum CatalogSyncStatus {
  RUNNING
  SUCCEEDED
  FAILED
  BLOCKED
}

enum ChannelAccountStatus {
  ACTIVE
  DISABLED
}

enum OperatorRole {
  OWNER
  ADMIN
  OPERATOR
  VIEWER
}

enum ConsentStatus {
  UNKNOWN
  GRANTED
  REVOKED
}

enum ConversationState {
  BOT_ACTIVE
  WAITING_OPERATOR
  OPERATOR_ACTIVE
  CLOSED
}

enum MessageAuthorType {
  CUSTOMER
  BOT
  OPERATOR
  SYSTEM
}

enum MessageDirection {
  INBOUND
  OUTBOUND
}

enum MessageType {
  TEXT
}

enum DeliveryState {
  PENDING
  SENT
  FAILED
  UNKNOWN
}

enum CatalogItemStatus {
  ACTIVE
  INACTIVE
  DELETED
}

enum PricingBasis {
  PER_PERSON
  PER_NIGHT
  PER_UNIT
  TOTAL
  UNSPECIFIED
}

enum AvailabilityStatus {
  AVAILABLE
  LIMITED
  SOLD_OUT
  UNKNOWN
}

enum LeadScore {
  HOT
  WARM
  COLD
}

enum LeadStatus {
  NEW
  IN_PROGRESS
  WON
  LOST
}

enum CrmSyncStatus {
  NOT_REQUIRED
  PENDING
  SYNCED
  FAILED
}

enum HandoverStatus {
  OPEN
  TAKEN
  RESOLVED
  CANCELLED
}

enum BookingStatus {
  REQUESTED
  CONFIRMED
  CANCELLED
  FAILED
}

enum InboundEventStatus {
  RECEIVED
  PROCESSING
  PROCESSED
  FAILED
}

enum OutboxEventStatus {
  PENDING
  PROCESSING
  SENT
  FAILED
}

/// Per channel account. OFF keeps the Phase 2 behavior; SHADOW runs the
/// agent and stores the draft without sending; LIVE sends (refused until an
/// operator handover notifier exists, except in local development).
enum AgentMode {
  OFF
  SHADOW
  LIVE
}

enum AgentTurnStatus {
  COMPUTING
  COMMITTED
  DISCARDED
  ABANDONED
  FAILED
}

enum HandoverNotificationStatus {
  PENDING
  SENT
  FAILED
}

enum AuditActorType {
  SYSTEM
  CUSTOMER
  OPERATOR
  ADMIN
}

model Tenant {
  id                 String       @id @default(uuid(7)) @db.Uuid
  slug               String       @unique @db.VarChar(80)
  name               String       @db.VarChar(200)
  status             TenantStatus @default(ACTIVE)
  defaultLocale      String       @map("default_locale") @db.VarChar(32)
  supportedLocales   String[]     @map("supported_locales")
  timezone           String       @db.VarChar(64)
  packKey            String       @map("pack_key") @db.VarChar(100)
  packVersion        String       @map("pack_version") @db.VarChar(64)
  enabledCapabilities String[]    @default([]) @map("enabled_capabilities")
  retentionSettings Json         @default("{}") @map("retention_settings") @db.JsonB
  config             Json         @default("{}") @db.JsonB
  createdAt          DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt          DateTime     @updatedAt @map("updated_at") @db.Timestamptz(6)

  connectors      TenantConnector[]
  catalogSyncRuns CatalogSyncRun[]
  llmUsage        LlmUsageRecord[]
  llmBudgetReservations LlmBudgetReservation[]
  internalNotes         InternalNote[]
  followUps             FollowUp[]
  knowledgeDocuments    KnowledgeDocument[]
  knowledgeChunks       KnowledgeChunk[]
  operatorApiTokens     OperatorApiToken[]
  operatorCredentials   OperatorCredential[]
  operatorSessions      OperatorSession[]
  inboxEvents           InboxEvent[]
  connectorOperations   ConnectorOperation[]
  actionProposals       ActionProposal[]
  shownOffers           ShownOffer[]
  channelAccounts ChannelAccount[]
  channelSecrets  ChannelSecret[]
  operators       Operator[]
  contacts        Contact[]
  conversations  Conversation[]
  messages        Message[]
  conversationSlots ConversationSlots[]
  agentTurns      AgentTurn[]
  catalogItems    CatalogItem[]
  offers          Offer[]
  aliases         CatalogAlias[]
  quotes          Quote[]
  leads           Lead[]
  handovers       Handover[]
  bookings        Booking[]
  inboundEvents   InboundEvent[]
  outboxEvents    OutboxEvent[]
  auditEvents     AuditEvent[]

  @@map("tenants")
}

model TenantConnector {
  id            String          @id @default(uuid(7)) @db.Uuid
  tenantId      String          @map("tenant_id") @db.Uuid
  connectorKey  String          @map("connector_key") @db.VarChar(100)
  status        ConnectorStatus @default(DISABLED)
  config        Json            @default("{}") @db.JsonB
  capabilities  String[]        @default([])
  secretRef     String?         @map("secret_ref") @db.VarChar(500)
  createdAt     DateTime        @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt     DateTime        @updatedAt @map("updated_at") @db.Timestamptz(6)
  tenant        Tenant          @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  syncRuns      CatalogSyncRun[]

  @@unique([tenantId, id])
  @@unique([tenantId, connectorKey])
  @@index([tenantId, status])
  @@map("tenant_connectors")
}

/// One catalog synchronisation attempt for a tenant connector. A partial
/// unique index (migration SQL) allows at most one RUNNING run per connector;
/// a run whose heartbeat goes stale is recovered as FAILED.
model CatalogSyncRun {
  id                String            @id @default(uuid(7)) @db.Uuid
  tenantId          String            @map("tenant_id") @db.Uuid
  tenantConnectorId String            @map("tenant_connector_id") @db.Uuid
  status            CatalogSyncStatus @default(RUNNING)
  sourceSystem      String?           @map("source_system") @db.VarChar(100)
  startedAt         DateTime          @default(now()) @map("started_at") @db.Timestamptz(6)
  heartbeatAt       DateTime          @default(now()) @map("heartbeat_at") @db.Timestamptz(6)
  finishedAt        DateTime?         @map("finished_at") @db.Timestamptz(6)
  itemsSeen         Int               @default(0) @map("items_seen")
  itemsUpserted     Int               @default(0) @map("items_upserted")
  itemsUnchanged    Int               @default(0) @map("items_unchanged")
  itemsDeactivated  Int               @default(0) @map("items_deactivated")
  offersSeen        Int               @default(0) @map("offers_seen")
  offersUpserted    Int               @default(0) @map("offers_upserted")
  offersUnchanged   Int               @default(0) @map("offers_unchanged")
  offersDeactivated Int               @default(0) @map("offers_deactivated")
  errorCode         String?           @map("error_code") @db.VarChar(100)
  errorCategory     String?           @map("error_category") @db.VarChar(40)
  createdAt         DateTime          @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt         DateTime          @updatedAt @map("updated_at") @db.Timestamptz(6)
  tenant            Tenant            @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  connector         TenantConnector   @relation(fields: [tenantId, tenantConnectorId], references: [tenantId, id], onDelete: Cascade)

  @@unique([tenantId, id])
  @@index([tenantId, tenantConnectorId, startedAt])
  @@index([status, heartbeatAt])
  @@map("catalog_sync_runs")
}

/// One provider request made by the agent, for cost accounting. Holds token
/// counts and cost only: no prompts, responses or customer text. Idempotent
/// on the provider response id, so re-recording a response cannot double
/// count; a retried turn makes new (billed) requests with new ids. There is
/// deliberately no FK to conversations, so cost history survives a privacy
/// deletion of conversation content.
model LlmUsageRecord {
  id                 String   @id @default(uuid(7)) @db.Uuid
  tenantId           String   @map("tenant_id") @db.Uuid
  conversationId     String?  @map("conversation_id") @db.Uuid
  turnKey            String   @map("turn_key") @db.VarChar(200)
  callIndex          Int      @map("call_index")
  purpose            String   @db.VarChar(20)
  tier               String   @db.VarChar(10)
  provider           String   @db.VarChar(40)
  model              String   @db.VarChar(100)
  responseId         String   @map("response_id") @db.VarChar(200)
  inputTokens        Int      @map("input_tokens")
  outputTokens       Int      @map("output_tokens")
  cacheReadTokens    Int      @map("cache_read_tokens")
  cacheWrite5mTokens Int      @map("cache_write_5m_tokens")
  cacheWrite1hTokens Int      @map("cache_write_1h_tokens")
  reasoningTokens    Int?     @map("reasoning_tokens")
  /// True when the provider reported no usage and counts were estimated.
  usageEstimated     Boolean  @default(false) @map("usage_estimated")
  costNano           BigInt   @map("cost_nano_usd")
  reservedNano       BigInt   @map("reserved_nano_usd")
  pricingVersion     String   @map("pricing_version") @db.VarChar(64)
  durationMs         Int      @map("duration_ms")
  attempts           Int
  outcome            String   @db.VarChar(40)
  createdAt          DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  tenant             Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, id])
  @@unique([tenantId, provider, responseId])
  @@index([tenantId, conversationId])
  @@index([tenantId, createdAt])
  @@map("llm_usage_records")
}

/// One attempt to answer a batch of inbound messages (claim -> compute ->
/// commit). The agent runs outside any transaction; only the claim and the
/// commit are short transactions. Partial unique indexes (migration SQL)
/// allow one COMPUTING turn per conversation and one COMMITTED turn per
/// idempotency key. Holds counts, cost, redacted tool summaries, guardrail
/// results and the draft reply; no raw customer text or prompts.
model AgentTurn {
  id                  String          @id @default(uuid(7)) @db.Uuid
  tenantId            String          @map("tenant_id") @db.Uuid
  conversationId      String          @map("conversation_id") @db.Uuid
  channelAccountId    String          @map("channel_account_id") @db.Uuid
  /// agent-reply:<conversationId>:<answeredSequence>
  idempotencyKey      String          @map("idempotency_key") @db.VarChar(200)
  attempt             Int
  mode                AgentMode
  status              AgentTurnStatus @default(COMPUTING)
  /// Outbox event id of the job that owns this attempt.
  claimToken          String          @map("claim_token") @db.VarChar(200)
  leaseExpiresAt      DateTime        @map("lease_expires_at") @db.Timestamptz(6)
  answeredSequence    Int             @map("answered_sequence")
  /// Highest inbound sequence in the conversation at claim time; a message
  /// above it at commit arrived during compute and supersedes this reply.
  seenInboundSequence Int             @default(0) @map("seen_inbound_sequence")
  conversationVersion Int             @map("conversation_version")
  inboundEventIds     String[]        @map("inbound_event_ids")
  correlationId       String          @map("correlation_id") @db.VarChar(100)
  outcome             String?         @db.VarChar(40)
  handoverReason      String?         @map("handover_reason") @db.VarChar(100)
  discardReason       String?         @map("discard_reason") @db.VarChar(40)
  failureCode         String?         @map("failure_code") @db.VarChar(100)
  locale              String?         @db.VarChar(16)
  provider            String?         @db.VarChar(40)
  models              String[]        @default([])
  llmCalls            Int             @default(0) @map("llm_calls")
  inputTokens         Int             @default(0) @map("input_tokens")
  outputTokens        Int             @default(0) @map("output_tokens")
  estimatedCostNano   BigInt          @default(0) @map("estimated_cost_nano_usd")
  actualCostNano      BigInt          @default(0) @map("actual_cost_nano_usd")
  latencyMs           Int?            @map("latency_ms")
  toolCalls           Json            @default("[]") @map("tool_calls") @db.JsonB
  guardrail           Json            @default("{}") @db.JsonB
  facts               Json            @default("[]") @db.JsonB
  /// Fact ids (F1..) that appear in the final reply, for offers-shown tracking.
  shownFactIds        Json            @default("[]") @map("shown_fact_ids") @db.JsonB
  /// Progress signals for the STUCK trigger (no raw customer text).
  askedSlot           String?         @map("asked_slot") @db.VarChar(100)
  slotsFilled         Int?            @map("slots_filled")
  textFingerprint     String?         @map("text_fingerprint") @db.VarChar(64)
  draftText           String?         @map("draft_text") @db.Text
  replyMessageId      String?         @map("reply_message_id") @db.Uuid
  handoverId          String?         @map("handover_id") @db.Uuid
  pricingVersion      String?         @map("pricing_version") @db.VarChar(64)
  promptVersion       String?         @map("prompt_version") @db.VarChar(64)
  packRef             String?         @map("pack_ref") @db.VarChar(170)
  startedAt           DateTime        @default(now()) @map("started_at") @db.Timestamptz(6)
  completedAt         DateTime?       @map("completed_at") @db.Timestamptz(6)
  createdAt           DateTime        @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt           DateTime        @updatedAt @map("updated_at") @db.Timestamptz(6)
  tenant              Tenant          @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  conversation        Conversation    @relation(fields: [tenantId, conversationId], references: [tenantId, id], onDelete: Cascade)
  channelAccount      ChannelAccount  @relation(fields: [tenantId, channelAccountId], references: [tenantId, id], onDelete: Restrict)

  @@unique([tenantId, id])
  @@unique([tenantId, idempotencyKey, attempt])
  @@index([tenantId, conversationId, status])
  @@index([status, leaseExpiresAt])
  @@map("agent_turns")
}

model ChannelAccount {
  id                String              @id @default(uuid(7)) @db.Uuid
  tenantId          String              @map("tenant_id") @db.Uuid
  channelType       String              @map("channel_type") @db.VarChar(40)
  externalAccountId String              @map("external_account_id") @db.VarChar(200)
  status            ChannelAccountStatus @default(DISABLED)
  credentialRef     String?             @map("credential_ref") @db.VarChar(500)
  webhookSecretRef  String?             @map("webhook_secret_ref") @db.VarChar(500)
  agentMode         AgentMode           @default(OFF) @map("agent_mode")
  /// A developer/test bot that only receives fake or seed data. Untrusted
  /// LLM providers may run in SHADOW only on such accounts unless
  /// LLM_ALLOW_REAL_CUSTOMER_DATA=true.
  isTestAccount     Boolean             @default(false) @map("is_test_account")
  /// Telegram chat (operator group) where handovers for this bot are posted.
  operatorChatId    String?             @map("operator_chat_id") @db.VarChar(200)
  createdAt         DateTime            @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt         DateTime            @updatedAt @map("updated_at") @db.Timestamptz(6)
  tenant            Tenant              @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  contacts     Contact[]
  conversations Conversation[]
  messages     Message[]
  inboundEvents InboundEvent[]
  agentTurns   AgentTurn[]
  secrets      ChannelSecret[]

  @@unique([tenantId, id])
  // Provider routing resolves the tenant from this globally unique account key.
  @@unique([channelType, externalAccountId])
  @@index([tenantId, status])
  @@map("channel_accounts")
}

/// Encrypted secret of one channel account (ADR 028): bot token, webhook
/// secret. AES-256-GCM; the associated data binds the value to tenant,
/// account and purpose. Only ciphertext is stored; the key is never in the
/// database. Read and written through ChannelSecretStore only.
model ChannelSecret {
  id               String         @id @default(uuid(7)) @db.Uuid
  tenantId         String         @map("tenant_id") @db.Uuid
  channelAccountId String         @map("channel_account_id") @db.Uuid
  purpose          String         @db.VarChar(40)
  keyId            String         @map("key_id") @db.VarChar(40)
  nonce            Bytes
  /// Ciphertext followed by the 16-byte GCM tag.
  ciphertext       Bytes
  createdAt        DateTime       @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt        DateTime       @updatedAt @map("updated_at") @db.Timestamptz(6)
  tenant           Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  channelAccount   ChannelAccount @relation(fields: [tenantId, channelAccountId], references: [tenantId, id], onDelete: Cascade)

  @@unique([tenantId, channelAccountId, purpose])
  @@map("channel_secrets")
}

model Operator {
  id          String       @id @default(uuid(7)) @db.Uuid
  tenantId    String       @map("tenant_id") @db.Uuid
  displayName String       @map("display_name") @db.VarChar(160)
  role        OperatorRole @default(OPERATOR)
  telegramUserId String?   @map("telegram_user_id") @db.VarChar(100)
  isActive    Boolean      @default(true) @map("is_active")
  createdAt   DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime     @updatedAt @map("updated_at") @db.Timestamptz(6)
  tenant      Tenant       @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  apiTokens             OperatorApiToken[]
  credentials           OperatorCredential[] // at most one: operator_id is unique
  sessions              OperatorSession[]
  assignedConversations Conversation[] @relation("AssignedOperator")
  assignedHandovers     Handover[]     @relation("AssignedHandoverOperator")

  @@unique([tenantId, id])
  @@unique([tenantId, telegramUserId])
  @@index([tenantId, isActive])
  @@map("operators")
}

model Contact {
  id                String        @id @default(uuid(7)) @db.Uuid
  tenantId          String        @map("tenant_id") @db.Uuid
  channelAccountId  String        @map("channel_account_id") @db.Uuid
  providerUserId    String        @map("provider_user_id") @db.VarChar(200)
  name              String?       @db.VarChar(200)
  phone             String?       @db.VarChar(40)
  language          String?       @db.VarChar(16)
  script            String?       @db.VarChar(16)
  consentStatus     ConsentStatus @default(UNKNOWN) @map("consent_status")
  consentAt         DateTime?     @map("consent_at") @db.Timestamptz(6)
  marketingOptOut   Boolean       @default(false) @map("marketing_opt_out")
  deletedAt         DateTime?     @map("deleted_at") @db.Timestamptz(6)
  createdAt         DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt         DateTime      @updatedAt @map("updated_at") @db.Timestamptz(6)
  tenant            Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  channelAccount    ChannelAccount @relation(fields: [tenantId, channelAccountId], references: [tenantId, id], onDelete: Restrict)

  conversations Conversation[]
  leads         Lead[]
  bookings      Booking[]

  @@unique([tenantId, id])
  @@unique([tenantId, channelAccountId, providerUserId])
  @@index([tenantId, phone])
  @@map("contacts")
}

model Conversation {
  id                  String           @id @default(uuid(7)) @db.Uuid
  tenantId            String           @map("tenant_id") @db.Uuid
  channelAccountId    String           @map("channel_account_id") @db.Uuid
  contactId           String           @map("contact_id") @db.Uuid
  providerChatId      String           @map("provider_chat_id") @db.VarChar(200)
  state               ConversationState @default(BOT_ACTIVE)
  version             Int              @default(1)
  assignedOperatorId  String?          @map("assigned_operator_id") @db.Uuid
  language            String?          @db.VarChar(16)
  script              String?          @db.VarChar(16)
  lastInboundAt       DateTime?        @map("last_inbound_at") @db.Timestamptz(6)
  createdAt           DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt           DateTime         @updatedAt @map("updated_at") @db.Timestamptz(6)
  tenant              Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  channelAccount      ChannelAccount   @relation(fields: [tenantId, channelAccountId], references: [tenantId, id], onDelete: Restrict)
  contact             Contact          @relation(fields: [tenantId, contactId], references: [tenantId, id], onDelete: Restrict)
  assignedOperator    Operator?        @relation("AssignedOperator", fields: [tenantId, assignedOperatorId], references: [tenantId, id], onDelete: Restrict)

  messages Message[]
  notes    InternalNote[]
  followUps FollowUp[]
  shownOffers ShownOffer[]
  slots    ConversationSlots[]
  quotes   Quote[]
  leads    Lead[]
  handovers Handover[]
  agentTurns AgentTurn[]
  actionProposals ActionProposal[]

  @@unique([tenantId, id])
  @@unique([tenantId, channelAccountId, providerChatId])
  @@index([tenantId, state, updatedAt])
  @@index([tenantId, contactId])
  @@index([tenantId, assignedOperatorId])
  @@map("conversations")
}

model Message {
  id                   String           @id @default(uuid(7)) @db.Uuid
  tenantId             String           @map("tenant_id") @db.Uuid
  conversationId       String           @map("conversation_id") @db.Uuid
  channelAccountId     String           @map("channel_account_id") @db.Uuid
  authorType           MessageAuthorType @map("author_type")
  direction            MessageDirection
  type                 MessageType       @default(TEXT)
  text                 String            @db.Text
  sequence             Int
  providerChatId       String            @map("provider_chat_id") @db.VarChar(200)
  providerMessageId    String?           @map("provider_message_id") @db.VarChar(200)
  deliveryState        DeliveryState     @default(UNKNOWN) @map("delivery_state")
  deliveryAttempts     Int               @default(0) @map("delivery_attempts")
  deliveryErrorCode    String?           @map("delivery_error_code") @db.VarChar(100)
  sendIdempotencyKey   String?           @map("send_idempotency_key") @db.VarChar(200)
  detectedLanguage     String?           @map("detected_language") @db.VarChar(16)
  detectedScript       String?           @map("detected_script") @db.VarChar(16)
  languageConfidence   Decimal?          @map("language_confidence") @db.Decimal(4, 3)
  createdAt            DateTime           @default(now()) @map("created_at") @db.Timestamptz(6)
  tenant               Tenant             @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  conversation         Conversation       @relation(fields: [tenantId, conversationId], references: [tenantId, id], onDelete: Cascade)
  channelAccount       ChannelAccount     @relation(fields: [tenantId, channelAccountId], references: [tenantId, id], onDelete: Restrict)

  shownQuotes Quote[] @relation("QuoteShownInMessage")

  @@unique([tenantId, id])
  @@unique([tenantId, conversationId, sequence])
  @@index([tenantId, conversationId, createdAt])
  @@index([tenantId, channelAccountId, providerMessageId])
  @@index([tenantId, sendIdempotencyKey])
  @@map("messages")
}

model ConversationSlots {
  id             String       @id @default(uuid(7)) @db.Uuid
  tenantId       String       @map("tenant_id") @db.Uuid
  conversationId String       @map("conversation_id") @db.Uuid
  version        Int
  slots          Json         @db.JsonB
  createdAt      DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)
  tenant         Tenant       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  conversation   Conversation @relation(fields: [tenantId, conversationId], references: [tenantId, id], onDelete: Cascade)

  @@unique([tenantId, id])
  @@unique([tenantId, conversationId, version])
  @@index([tenantId, conversationId])
  @@map("conversation_slots")
}

model CatalogItem {
  id               String           @id @default(uuid(7)) @db.Uuid
  tenantId         String           @map("tenant_id") @db.Uuid
  sourceSystem     String           @map("source_system") @db.VarChar(100)
  sourceEntityId   String           @map("source_entity_id") @db.VarChar(200)
  itemType         String           @map("item_type") @db.VarChar(100)
  title            String           @db.VarChar(500)
  normalizedTitle  String           @map("normalized_title") @db.VarChar(600)
  normalizerVersion Int             @default(1) @map("normalizer_version")
  description      String?          @db.Text
  attributes       Json             @default("{\"fields\":{}}") @db.JsonB
  syncedAt         DateTime         @map("synced_at") @db.Timestamptz(6)
  sourceHash       String           @map("source_hash") @db.VarChar(128)
  status           CatalogItemStatus @default(ACTIVE)
  deletedAt        DateTime?        @map("deleted_at") @db.Timestamptz(6)
  createdAt        DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt        DateTime         @updatedAt @map("updated_at") @db.Timestamptz(6)
