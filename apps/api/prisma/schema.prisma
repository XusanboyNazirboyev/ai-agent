  expiresAt        DateTime?         @map("expires_at") @db.Timestamptz(6)
  tenant           Tenant            @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  channelAccount   ChannelAccount    @relation(fields: [tenantId, channelAccountId], references: [tenantId, id], onDelete: Restrict)

  @@unique([tenantId, id])
  @@unique([tenantId, channelAccountId, providerEventId])
  @@index([tenantId, status, receivedAt])
  @@index([tenantId, channelAccountId, receivedAt])
  @@index([tenantId, expiresAt])
  @@map("inbound_events")
}

model OutboxEvent {
  id            String           @id @default(uuid(7)) @db.Uuid
  tenantId      String           @map("tenant_id") @db.Uuid
  type          String           @db.VarChar(100)
  aggregateType String           @map("aggregate_type") @db.VarChar(100)
  aggregateId   String           @map("aggregate_id") @db.VarChar(200)
  idempotencyKey String?         @map("idempotency_key") @db.VarChar(200)
  payload       Json             @db.JsonB
  status        OutboxEventStatus @default(PENDING)
  attempts      Int              @default(0)
  availableAt   DateTime         @default(now()) @map("available_at") @db.Timestamptz(6)
  createdAt     DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt     DateTime         @updatedAt @map("updated_at") @db.Timestamptz(6)
  tenant        Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, id])
  @@unique([tenantId, idempotencyKey])
  @@index([tenantId, status, availableAt])
  @@index([tenantId, aggregateType, aggregateId])
  @@map("outbox_events")
}

model AuditEvent {
  id              String         @id @default(uuid(7)) @db.Uuid
  tenantId        String         @map("tenant_id") @db.Uuid
  actorType       AuditActorType @map("actor_type")
  actorId         String?        @map("actor_id") @db.VarChar(200)
  action          String         @db.VarChar(120)
  entityType      String         @map("entity_type") @db.VarChar(100)
  entityId        String         @map("entity_id") @db.VarChar(200)
  safeInputSummary Json           @default("{}") @map("safe_input_summary") @db.JsonB
  idempotencyKey  String?        @map("idempotency_key") @db.VarChar(200)
  correlationId   String?        @map("correlation_id") @db.VarChar(200)
  createdAt       DateTime       @default(now()) @map("created_at") @db.Timestamptz(6)
  tenant          Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, id])
  @@index([tenantId, createdAt])
  @@index([tenantId, entityType, entityId])
  @@map("audit_events")
}

/// Worst-case budget reservation for one potentially billable provider
/// invocation (ADR 014). Created under a per-tenant advisory lock so the
/// tenant-month cap is enforced atomically across processes. States:
/// RESERVED (in flight), UNKNOWN (billing cannot be determined; stays
/// counted), SETTLED (actual usage recorded in llm_usage_records; no longer
/// counted), RELEASED (certainly unbilled; no longer counted). Kept apart
/// from llm_usage_records so reserved exposure is never mistaken for spend.
model LlmBudgetReservation {
  id               String   @id @default(uuid(7)) @db.Uuid
  tenantId         String   @map("tenant_id") @db.Uuid
  conversationId   String?  @map("conversation_id") @db.Uuid
  /// `<turnKey>:<callIndex>`: stable across job retries.
  baseInvocationId String   @map("base_invocation_id") @db.VarChar(200)
  /// `<base>#<n>`: one row per real provider invocation, unique per tenant.
  invocationId     String   @map("invocation_id") @db.VarChar(210)
  /// UTC start of the month the reservation counts against.
  periodStart      DateTime @map("period_start") @db.Timestamptz(6)
  reservedNano     BigInt   @map("reserved_nano_usd")
  reservedTokens   BigInt   @map("reserved_tokens")
  state            String   @db.VarChar(16)
  expiresAt        DateTime @map("expires_at") @db.Timestamptz(6)
  createdAt        DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt        DateTime @default(now()) @map("updated_at") @db.Timestamptz(6)
  tenant           Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, invocationId])
  @@index([tenantId, periodStart, state])
  @@index([tenantId, conversationId, state])
  @@index([tenantId, baseInvocationId])
  @@map("llm_budget_reservations")
}

/// Internal operator note on a conversation (never sent to the customer).
model InternalNote {
  id             String       @id @default(uuid(7)) @db.Uuid
  tenantId       String       @map("tenant_id") @db.Uuid
  conversationId String       @map("conversation_id") @db.Uuid
  operatorId     String       @map("operator_id") @db.Uuid
  text           String       @db.Text
  idempotencyKey String       @map("idempotency_key") @db.VarChar(200)
  createdAt      DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)
  tenant         Tenant       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  conversation   Conversation @relation(fields: [tenantId, conversationId], references: [tenantId, id], onDelete: Cascade)

  @@unique([tenantId, id])
  @@unique([tenantId, idempotencyKey])
  @@index([tenantId, conversationId, createdAt])
  @@map("internal_notes")
}

/// What a customer was actually shown: written only after the outgoing
/// message was delivered (never for a draft or a failed send). The snapshot
/// keeps the exact verified facts with provenance. A `Quote` row is written
/// only when the offer exists in the synced catalog (its FK); otherwise
/// `quoteRecorded` is false with the reason.
model ShownOffer {
  id             String       @id @default(uuid(7)) @db.Uuid
  tenantId       String       @map("tenant_id") @db.Uuid
  conversationId String       @map("conversation_id") @db.Uuid
  messageId      String       @map("message_id") @db.Uuid
  /// Connector offer id (or item id when no offer was involved).
  offerRef       String       @map("offer_ref") @db.VarChar(300)
  offerId        String?      @map("offer_id") @db.Uuid
  facts          Json         @db.JsonB
  quoteRecorded  Boolean      @default(false) @map("quote_recorded")
  quoteSkipReason String?     @map("quote_skip_reason") @db.VarChar(100)
  shownAt        DateTime     @default(now()) @map("shown_at") @db.Timestamptz(6)
  tenant         Tenant       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  conversation   Conversation @relation(fields: [tenantId, conversationId], references: [tenantId, id], onDelete: Cascade)

  @@unique([tenantId, id])
  @@unique([tenantId, messageId, offerRef])
  @@index([tenantId, conversationId, shownAt])
  @@map("shown_offers")
}

/// API credential of one operator for the operator command API. Only the
/// SHA-256 of the token is stored; the token is shown once at creation.
model OperatorApiToken {
  id         String    @id @default(uuid(7)) @db.Uuid
  tenantId   String    @map("tenant_id") @db.Uuid
  operatorId String    @map("operator_id") @db.Uuid
  tokenHash  String    @unique @map("token_hash") @db.VarChar(64)
  label      String    @db.VarChar(120)
  createdAt  DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  lastUsedAt DateTime? @map("last_used_at") @db.Timestamptz(6)
  revokedAt  DateTime? @map("revoked_at") @db.Timestamptz(6)
  tenant     Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  operator   Operator  @relation(fields: [tenantId, operatorId], references: [tenantId, id], onDelete: Cascade)

  @@unique([tenantId, id])
  @@index([tenantId, operatorId])
  @@map("operator_api_tokens")
}

/// One follow-up sent to a silent customer (Phase 6). The unique ordinal makes
/// the scheduler idempotent: a scan can never send the same follow-up twice.
model FollowUp {
  id             String       @id @default(uuid(7)) @db.Uuid
  tenantId       String       @map("tenant_id") @db.Uuid
  conversationId String       @map("conversation_id") @db.Uuid
  ordinal        Int
  messageId      String?      @map("message_id") @db.Uuid
  createdAt      DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)
  tenant         Tenant       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  conversation   Conversation @relation(fields: [tenantId, conversationId], references: [tenantId, id], onDelete: Cascade)

  @@unique([tenantId, id])
  @@unique([tenantId, conversationId, ordinal])
  @@index([tenantId, createdAt])
  @@map("follow_ups")
}

/// Textual knowledge (policies, FAQ, info texts) for RAG (D2). Never a source
/// of prices, dates, seats or availability (D1): those come from the CRM.
/// `source` and `sourceUpdatedAt` are the internal attribution; for a
/// `regulated` document the update date is also shown to the customer.
model KnowledgeDocument {
  id              String   @id @default(uuid(7)) @db.Uuid
  tenantId        String   @map("tenant_id") @db.Uuid
  title           String   @db.VarChar(300)
  source          String   @db.VarChar(300)
  sourceUpdatedAt DateTime @map("source_updated_at") @db.Timestamptz(6)
  language        String?  @db.VarChar(8)
  topic           String?  @db.VarChar(100)
  regulated       Boolean  @default(false)
  status          String   @default("ACTIVE") @db.VarChar(16)
  contentHash     String   @map("content_hash") @db.VarChar(64)
  createdAt       DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime @default(now()) @map("updated_at") @db.Timestamptz(6)
  tenant          Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  chunks          KnowledgeChunk[]

  @@unique([tenantId, id])
  @@unique([tenantId, source])
  @@index([tenantId, status, topic])
  @@map("knowledge_documents")
}

/// One embedded passage. The vector column is untyped (any length) because
/// the embedding model, and so its size, is configuration; searches filter on
/// `embedding_model` and `embedding_dims` so vectors of different models are
/// never compared. Read and written with raw SQL (pgvector).
model KnowledgeChunk {
  id             String   @id @default(uuid(7)) @db.Uuid
  tenantId       String   @map("tenant_id") @db.Uuid
  documentId     String   @map("document_id") @db.Uuid
  ordinal        Int
  text           String   @db.Text
  embedding      Unsupported("vector")?
  embeddingModel String   @map("embedding_model") @db.VarChar(100)
  embeddingDims  Int      @map("embedding_dims")
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  tenant         Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  document       KnowledgeDocument @relation(fields: [tenantId, documentId], references: [tenantId, id], onDelete: Cascade)

  @@unique([tenantId, id])
  @@unique([tenantId, documentId, ordinal])
  @@index([tenantId, embeddingModel])
  @@map("knowledge_chunks")
}

/// Web-inbox login of one operator (Phase 6A, ADR 020). Only a scrypt hash of
/// the password is stored. Email is unique across tenants and resolves the
/// tenant at login; it is never taken from a request afterwards.
model OperatorCredential {
  id             String    @id @default(uuid(7)) @db.Uuid
  tenantId       String    @map("tenant_id") @db.Uuid
  operatorId     String    @unique @map("operator_id") @db.Uuid
  email          String    @unique @db.VarChar(254)
  passwordHash   String    @map("password_hash") @db.VarChar(255)
  failedAttempts Int       @default(0) @map("failed_attempts")
  lockedUntil    DateTime? @map("locked_until") @db.Timestamptz(6)
  /// ADR 048: TOTP secret sealed with the keyring; pending while totpEnabledAt is null.
  totpKeyId        String?   @map("totp_key_id") @db.VarChar(40)
  totpNonce        Bytes?    @map("totp_nonce")
  totpCiphertext   Bytes?    @map("totp_ciphertext")
  totpEnabledAt    DateTime? @map("totp_enabled_at") @db.Timestamptz(6)
  totpLastStep     Int?      @map("totp_last_step")
  mfaRecoveryHashes String[] @default([]) @map("mfa_recovery_hashes")
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)
  tenant         Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  operator       Operator  @relation(fields: [tenantId, operatorId], references: [tenantId, id], onDelete: Cascade)

  @@unique([tenantId, id])
  @@map("operator_credentials")
}

/// Browser session of an operator. The cookie carries a random token; only its
/// SHA-256 is stored. csrfHash is the hash of the per-session CSRF token.
model OperatorSession {
  id         String    @id @default(uuid(7)) @db.Uuid
  tenantId   String    @map("tenant_id") @db.Uuid
  operatorId String    @map("operator_id") @db.Uuid
  tokenHash  String    @unique @map("token_hash") @db.VarChar(64)
  csrfHash   String    @map("csrf_hash") @db.VarChar(64)
  createdAt  DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  lastSeenAt DateTime  @default(now()) @map("last_seen_at") @db.Timestamptz(6)
  expiresAt  DateTime  @map("expires_at") @db.Timestamptz(6)
  revokedAt  DateTime? @map("revoked_at") @db.Timestamptz(6)
  tenant     Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  operator   Operator  @relation(fields: [tenantId, operatorId], references: [tenantId, id], onDelete: Cascade)

  @@unique([tenantId, id])
  @@index([tenantId, operatorId])
  @@map("operator_sessions")
}

/// Ordered per-tenant change feed for the inbox SSE stream. Rows are written
/// by database triggers on conversations, messages and handovers (so every
/// writer is covered, atomically) and carry only ids. `id` is the SSE event id.
model InboxEvent {
  id             BigInt   @id @default(autoincrement())
  tenantId       String   @map("tenant_id") @db.Uuid
  type           String   @db.VarChar(40)
  conversationId String?  @map("conversation_id") @db.Uuid
  handoverId     String?  @map("handover_id") @db.Uuid
  messageId      String?  @map("message_id") @db.Uuid
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  tenant         Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId, id])
  @@index([createdAt])
  @@map("inbox_events")
}

enum ConnectorOperationStatus {
  PENDING
  IN_FLIGHT
  RETRY_WAIT
  SUCCEEDED
  FAILED
  UNCERTAIN
  RESOLVED_SUCCEEDED
  RESOLVED_FAILED
}

/// One logical external write (ADR 023): created once per subject and kind,
/// carries the idempotency key used for EVERY attempt, a lease so only one
/// worker attempts it at a time, and the evidence or the reason it stopped.
/// UNCERTAIN = the remote system may have applied it and nothing can prove
/// either way; it is never retried automatically and waits for a person.
model ConnectorOperation {
  id              String                   @id @default(uuid(7)) @db.Uuid
  tenantId        String                   @map("tenant_id") @db.Uuid
  kind            String                   @db.VarChar(40)
  subjectType     String                   @map("subject_type") @db.VarChar(40)
  subjectId       String                   @map("subject_id") @db.Uuid
  idempotencyKey  String                   @unique @map("idempotency_key") @db.VarChar(200)
  status          ConnectorOperationStatus @default(PENDING)
  attempts        Int                      @default(0)
  /// Idempotency mode of the connector during the latest attempt.
  attemptMode     String?                  @map("attempt_mode") @db.VarChar(10)
  /// NOT_EXECUTED or UNCERTAIN: what the latest failed attempt proved.
  lastExecution   String?                  @map("last_execution") @db.VarChar(20)
  leaseToken      String?                  @map("lease_token") @db.VarChar(64)
  leaseExpiresAt  DateTime?                @map("lease_expires_at") @db.Timestamptz(6)
  nextAttemptAt   DateTime?                @map("next_attempt_at") @db.Timestamptz(6)
  externalId      String?                  @map("external_id") @db.VarChar(200)
  lastErrorCode   String?                  @map("last_error_code") @db.VarChar(100)
  resolvedBy      String?                  @map("resolved_by") @db.VarChar(200)
  createdAt       DateTime                 @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime                 @updatedAt @map("updated_at") @db.Timestamptz(6)
  completedAt     DateTime?                @map("completed_at") @db.Timestamptz(6)
  tenant          Tenant                   @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, id])
  @@unique([tenantId, kind, subjectType, subjectId])
  @@index([status, nextAttemptAt])
  @@index([status, leaseExpiresAt])
  @@map("connector_operations")
}

enum ActionProposalStatus {
  PROPOSED
  CONFIRMED
  DECLINED
  SUPERSEDED
  EXPIRED
  CANCELLED
  SUCCEEDED
  FAILED
  UNCERTAIN
}

/// A business action the agent proposed to a customer (ADR 024). The payload
/// holds only the pack-declared fields, is bound by `digest`, and is cleared
/// once the action reaches a final state. Execution is the connector
/// operation with subject ('action_proposal', id).
model ActionProposal {
  id               String               @id @default(uuid(7)) @db.Uuid
  tenantId         String               @map("tenant_id") @db.Uuid
  conversationId   String               @map("conversation_id") @db.Uuid
  actionKey        String               @map("action_key") @db.VarChar(41)
  operation        String               @db.VarChar(40)
  packRef          String               @map("pack_ref") @db.VarChar(100)
  payload          Json?                @db.JsonB
  digest           String               @db.VarChar(64)
  status           ActionProposalStatus @default(PROPOSED)
  expiresAt        DateTime             @map("expires_at") @db.Timestamptz(6)
  proposedTurnKey  String               @map("proposed_turn_key") @db.VarChar(200)
  confirmedAt      DateTime?            @map("confirmed_at") @db.Timestamptz(6)
  outcomeAt        DateTime?            @map("outcome_at") @db.Timestamptz(6)
  externalId       String?              @map("external_id") @db.VarChar(200)
  errorCode        String?              @map("error_code") @db.VarChar(100)
  payloadClearedAt DateTime?            @map("payload_cleared_at") @db.Timestamptz(6)
  createdAt        DateTime             @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt        DateTime             @updatedAt @map("updated_at") @db.Timestamptz(6)
  tenant           Tenant               @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  conversation     Conversation         @relation(fields: [tenantId, conversationId], references: [tenantId, id], onDelete: Cascade)

  @@unique([tenantId, id])
  @@unique([tenantId, proposedTurnKey], map: "action_proposals_proposed_turn_key_key")
  @@index([tenantId, conversationId, status])
  @@index([status, expiresAt])
  @@map("action_proposals")
}

/// ADR 043: a top-level comment on the tenant's Instagram post. The text is
/// the inbound COMMENT message (untrusted); this row tracks the replies.
model InstagramComment {
  id                    String                 @id @default(uuid(7)) @db.Uuid
  tenantId              String                 @map("tenant_id") @db.Uuid
  channelAccountId      String                 @map("channel_account_id") @db.Uuid
  conversationId        String                 @map("conversation_id") @db.Uuid
  /// The inbound COMMENT message that carries the text.
  messageId             String                 @map("message_id") @db.Uuid
  /// Meta's comment id (digits only, checked at intake).
  commentId             String                 @map("comment_id") @db.VarChar(100)
  mediaId               String?                @map("media_id") @db.VarChar(100)
  mediaProductType      String?                @map("media_product_type") @db.VarChar(50)
  status                InstagramCommentStatus @default(RECEIVED)
  /// Our outbound message sent as the one private reply.
  privateReplyMessageId String?                @map("private_reply_message_id") @db.Uuid
  /// The public reply's comment id returned by Meta.
  publicReplyId         String?                @map("public_reply_id") @db.VarChar(100)
  errorCode             String?                @map("error_code") @db.VarChar(100)
  commentedAt           DateTime               @map("commented_at") @db.Timestamptz(6)
  createdAt             DateTime               @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt             DateTime               @updatedAt @map("updated_at") @db.Timestamptz(6)
  tenant                Tenant                 @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  channelAccount        ChannelAccount         @relation(fields: [tenantId, channelAccountId], references: [tenantId, id], onDelete: Restrict)
  conversation          Conversation           @relation(fields: [tenantId, conversationId], references: [tenantId, id], onDelete: Cascade)

  @@unique([tenantId, id])
  @@unique([tenantId, channelAccountId, commentId])
  @@unique([tenantId, messageId])
  @@index([tenantId, channelAccountId, status, createdAt])
  @@map("instagram_comments")
}

enum AppointmentStatus {
  HELD
  CONFIRMED
  CANCELLED
  COMPLETED
  EXPIRED
}

/// ADR 046: a bookable service with duration, buffers and required skills.
model ServiceType {
  id                  String   @id @default(uuid(7)) @db.Uuid
  tenantId            String   @map("tenant_id") @db.Uuid
  key                 String   @db.VarChar(100)
  title               String   @db.VarChar(200)
  durationMinutes     Int      @map("duration_minutes")
  bufferBeforeMinutes Int      @default(0) @map("buffer_before_minutes")
  bufferAfterMinutes  Int      @default(0) @map("buffer_after_minutes")
  leadTimeMinutes     Int      @default(0) @map("lead_time_minutes")
  requiredSkills      String[] @default([]) @map("required_skills")
  catalogItemId       String?  @map("catalog_item_id") @db.Uuid
  active              Boolean  @default(true)
  createdAt           DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt           DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)
  tenant              Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  appointments Appointment[]

  @@unique([tenantId, id])
  @@unique([tenantId, key])
  @@map("service_types")
}

/// ADR 046: a person who performs services. Not an operator account.
model StaffMember {
  id          String   @id @default(uuid(7)) @db.Uuid
  tenantId    String   @map("tenant_id") @db.Uuid
  displayName String   @map("display_name") @db.VarChar(200)
  skills      String[] @default([])
  /// IANA zone; null means the tenant timezone.
  timezone    String?  @db.VarChar(64)
  active      Boolean  @default(true)
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)
  tenant      Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  rules        AvailabilityRule[]
  exceptions   AvailabilityException[]
  appointments Appointment[]

  @@unique([tenantId, id])
  @@map("staff_members")
}

/// Weekly working window in the staff member's local time (weekday 1=Mon..7=Sun).
model AvailabilityRule {
  id            String      @id @default(uuid(7)) @db.Uuid
  tenantId      String      @map("tenant_id") @db.Uuid
  staffMemberId String      @map("staff_member_id") @db.Uuid
  weekday       Int
  startTime     String      @map("start_time") @db.VarChar(5)
  endTime       String      @map("end_time") @db.VarChar(5)
  validFrom     DateTime?   @map("valid_from") @db.Date
  validUntil    DateTime?   @map("valid_until") @db.Date
  createdAt     DateTime    @default(now()) @map("created_at") @db.Timestamptz(6)
  tenant        Tenant      @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  staffMember   StaffMember @relation(fields: [tenantId, staffMemberId], references: [tenantId, id], onDelete: Cascade)

  @@unique([tenantId, id])
  @@index([tenantId, staffMemberId, weekday])
  @@map("availability_rules")
}

/// Local date range that removes (leave, holiday) or adds working time.
model AvailabilityException {
  id            String      @id @default(uuid(7)) @db.Uuid
  tenantId      String      @map("tenant_id") @db.Uuid
  staffMemberId String      @map("staff_member_id") @db.Uuid
  startDate     DateTime    @map("start_date") @db.Date
  endDate       DateTime    @map("end_date") @db.Date
  /// Local time of day; both null means the whole day(s).
  startTime     String?     @map("start_time") @db.VarChar(5)
  endTime       String?     @map("end_time") @db.VarChar(5)
  unavailable   Boolean     @default(true)
  reason        String?     @db.VarChar(200)
  createdAt     DateTime    @default(now()) @map("created_at") @db.Timestamptz(6)
  tenant        Tenant      @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  staffMember   StaffMember @relation(fields: [tenantId, staffMemberId], references: [tenantId, id], onDelete: Cascade)

  @@unique([tenantId, id])
  @@index([tenantId, staffMemberId, startDate])
  @@map("availability_exceptions")
}

/// ADR 046. The exclusion constraint on (tenant, staff, blocked range) for
/// HELD/CONFIRMED rows and the CHECK constraints are in the migration SQL.
model Appointment {
  id             String            @id @default(uuid(7)) @db.Uuid
  tenantId       String            @map("tenant_id") @db.Uuid
  serviceTypeId  String            @map("service_type_id") @db.Uuid
  staffMemberId  String            @map("staff_member_id") @db.Uuid
  contactId      String            @map("contact_id") @db.Uuid
  conversationId String?           @map("conversation_id") @db.Uuid
  startsAt       DateTime          @map("starts_at") @db.Timestamptz(6)
  endsAt         DateTime          @map("ends_at") @db.Timestamptz(6)
  blockedFrom    DateTime          @map("blocked_from") @db.Timestamptz(6)
  blockedUntil   DateTime          @map("blocked_until") @db.Timestamptz(6)
  status         AppointmentStatus @default(HELD)
  holdExpiresAt  DateTime?         @map("hold_expires_at") @db.Timestamptz(6)
  idempotencyKey String            @map("idempotency_key") @db.VarChar(200)
  crmSyncStatus  CrmSyncStatus     @default(NOT_REQUIRED) @map("crm_sync_status")
  crmExternalId  String?           @map("crm_external_id") @db.VarChar(200)
  createdAt      DateTime          @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime          @updatedAt @map("updated_at") @db.Timestamptz(6)
  tenant         Tenant            @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  serviceType    ServiceType       @relation(fields: [tenantId, serviceTypeId], references: [tenantId, id], onDelete: Restrict)
  staffMember    StaffMember       @relation(fields: [tenantId, staffMemberId], references: [tenantId, id], onDelete: Restrict)
  contact        Contact           @relation(fields: [tenantId, contactId], references: [tenantId, id], onDelete: Restrict)
  conversation   Conversation?     @relation(fields: [tenantId, conversationId], references: [tenantId, id], onDelete: Restrict)

  @@unique([tenantId, id])
  @@unique([tenantId, idempotencyKey])
  @@index([tenantId, staffMemberId, blockedFrom])
  @@index([tenantId, status, holdExpiresAt])
  @@map("appointments")
}

// ADR 047: platform console, subscriptions and two-layer RBAC.

enum PlatformRole {
  PLATFORM_OWNER
  PLATFORM_SUPPORT
}

enum SubscriptionStatus {
  TRIAL
  ACTIVE
  PAST_DUE
  EXPIRED
  CANCELED
}

enum PaymentProvider {
  MANUAL
  CLICK
}

enum PaymentStatus {
  PENDING
  PAID
  FAILED
  REFUNDED
}

/// Principal above the tenants (ADR 047). Not related to any tenant. A row
/// created by an invite has no password until the invite is accepted.
model PlatformAdmin {
  id              String       @id @default(uuid(7)) @db.Uuid
  email           String       @unique @db.VarChar(254)
  displayName     String       @map("display_name") @db.VarChar(160)
  role            PlatformRole @default(PLATFORM_SUPPORT)
  passwordHash    String?      @map("password_hash") @db.VarChar(255)
  failedAttempts  Int          @default(0) @map("failed_attempts")
  lockedUntil     DateTime?    @map("locked_until") @db.Timestamptz(6)
  isActive        Boolean      @default(true) @map("is_active")
  inviteTokenHash String?      @unique @map("invite_token_hash") @db.VarChar(64)
  inviteExpiresAt DateTime?    @map("invite_expires_at") @db.Timestamptz(6)
  /// ADR 048: TOTP secret sealed with the keyring; pending while totpEnabledAt is null.
  totpKeyId        String?   @map("totp_key_id") @db.VarChar(40)
  totpNonce        Bytes?    @map("totp_nonce")
  totpCiphertext   Bytes?    @map("totp_ciphertext")
  totpEnabledAt    DateTime? @map("totp_enabled_at") @db.Timestamptz(6)
  totpLastStep     Int?      @map("totp_last_step")
  mfaRecoveryHashes String[] @default([]) @map("mfa_recovery_hashes")
  createdAt       DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime     @updatedAt @map("updated_at") @db.Timestamptz(6)

  sessions    PlatformSession[]
  auditEvents PlatformAuditEvent[]
  payments    SubscriptionPayment[]

  @@map("platform_admins")
}

/// Browser session of a platform admin; only hashes are stored.
model PlatformSession {
  id         String        @id @default(uuid(7)) @db.Uuid
  adminId    String        @map("admin_id") @db.Uuid
  tokenHash  String        @unique @map("token_hash") @db.VarChar(64)
  csrfHash   String        @map("csrf_hash") @db.VarChar(64)
  createdAt  DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)
  lastSeenAt DateTime      @default(now()) @map("last_seen_at") @db.Timestamptz(6)
  expiresAt  DateTime      @map("expires_at") @db.Timestamptz(6)
  revokedAt  DateTime?     @map("revoked_at") @db.Timestamptz(6)
  admin      PlatformAdmin @relation(fields: [adminId], references: [id], onDelete: Cascade)

  @@index([adminId])
  @@map("platform_sessions")
}

/// Prices are integers in minor units, rendered by code; not seeded.
model SubscriptionPlan {
  id         String   @id @default(uuid(7)) @db.Uuid
  code       String   @unique @db.VarChar(60)
  name       String   @db.VarChar(200)
  priceMinor BigInt   @map("price_minor")
  currency   String   @default("UZS") @db.VarChar(3)
  periodDays Int      @map("period_days")
  /// { maxOperators?, maxChannelAccounts?, monthlyLlmBudgetUsd? }
  limits     Json     @default("{}") @db.JsonB
  isActive   Boolean  @default(true) @map("is_active")
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt  DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  subscriptions TenantSubscription[]

  @@map("subscription_plans")
}

/// Subscription history of a tenant. At most one open row (TRIAL, ACTIVE,
/// PAST_DUE) per tenant: partial unique index in the migration SQL.
model TenantSubscription {
  id                 String             @id @default(uuid(7)) @db.Uuid
  tenantId           String             @map("tenant_id") @db.Uuid
  planId             String             @map("plan_id") @db.Uuid
  status             SubscriptionStatus
  currentPeriodStart DateTime           @map("current_period_start") @db.Timestamptz(6)
  currentPeriodEnd   DateTime           @map("current_period_end") @db.Timestamptz(6)
  graceUntil         DateTime?          @map("grace_until") @db.Timestamptz(6)
  canceledAt         DateTime?          @map("canceled_at") @db.Timestamptz(6)
  notes              String?            @db.VarChar(500)
  createdAt          DateTime           @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt          DateTime           @updatedAt @map("updated_at") @db.Timestamptz(6)
  tenant             Tenant             @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  plan               SubscriptionPlan   @relation(fields: [planId], references: [id], onDelete: Restrict)

  payments SubscriptionPayment[]

  @@unique([tenantId, id])
  @@index([tenantId, createdAt])
  @@index([status, currentPeriodEnd])
  @@map("tenant_subscriptions")
}

/// MANUAL rows are recorded in the console; CLICK rows come from the Click
/// adapter. safeSummary never holds raw provider payloads.
model SubscriptionPayment {
  id             String              @id @default(uuid(7)) @db.Uuid
  tenantId       String              @map("tenant_id") @db.Uuid
  subscriptionId String?             @map("subscription_id") @db.Uuid
  provider       PaymentProvider
  providerRef    String              @map("provider_ref") @db.VarChar(200)
  amountMinor    BigInt              @map("amount_minor")
  currency       String              @default("UZS") @db.VarChar(3)
  status         PaymentStatus
  paidAt         DateTime?           @map("paid_at") @db.Timestamptz(6)
  recordedById   String?             @map("recorded_by_id") @db.Uuid
  safeSummary    Json                @default("{}") @map("safe_summary") @db.JsonB
  createdAt      DateTime            @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime            @updatedAt @map("updated_at") @db.Timestamptz(6)
  tenant         Tenant              @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  subscription   TenantSubscription? @relation(fields: [tenantId, subscriptionId], references: [tenantId, id], onDelete: Restrict)
  recordedBy     PlatformAdmin?      @relation(fields: [recordedById], references: [id], onDelete: SetNull)

  @@unique([tenantId, id])
  @@unique([provider, providerRef])
  @@index([tenantId, createdAt])
  @@map("subscription_payments")
}

/// Invite to join a tenant as an operator. Only the token hash is stored;
/// the plain token is shown once. Created by a platform admin or an operator.
model OperatorInvite {
  id                       String       @id @default(uuid(7)) @db.Uuid
  tenantId                 String       @map("tenant_id") @db.Uuid
  email                    String       @db.VarChar(254)
  role                     OperatorRole
  tokenHash                String       @unique @map("token_hash") @db.VarChar(64)
  expiresAt                DateTime     @map("expires_at") @db.Timestamptz(6)
  acceptedAt               DateTime?    @map("accepted_at") @db.Timestamptz(6)
  acceptedOperatorId       String?      @map("accepted_operator_id") @db.Uuid
  revokedAt                DateTime?    @map("revoked_at") @db.Timestamptz(6)
  createdByPlatformAdminId String?      @map("created_by_platform_admin_id") @db.Uuid
  createdByOperatorId      String?      @map("created_by_operator_id") @db.Uuid
  createdAt                DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)
  tenant                   Tenant       @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, id])
  @@index([tenantId, createdAt])
  @@index([tenantId, email])
  @@map("operator_invites")
}

/// Audit trail of the platform console and of subscription transitions.
/// actorAdminId is null for system transitions (the subscription scan).
model PlatformAuditEvent {
  id           String         @id @default(uuid(7)) @db.Uuid
  actorAdminId String?        @map("actor_admin_id") @db.Uuid
  action       String         @db.VarChar(120)
  tenantId     String?        @map("tenant_id") @db.Uuid
  entityType   String         @map("entity_type") @db.VarChar(100)
  entityId     String         @map("entity_id") @db.VarChar(200)
  safeSummary  Json           @default("{}") @map("safe_summary") @db.JsonB
  createdAt    DateTime       @default(now()) @map("created_at") @db.Timestamptz(6)
  actor        PlatformAdmin? @relation(fields: [actorAdminId], references: [id], onDelete: SetNull)
  tenant       Tenant?        @relation(fields: [tenantId], references: [id], onDelete: SetNull)

  @@index([createdAt])
  @@index([tenantId, createdAt])
  @@map("platform_audit_events")
}

/// ADR 048: short-lived step between a correct password and a session. Only the
/// SHA-256 of the token is stored. principalType is OPERATOR or PLATFORM_ADMIN;
/// purpose is LOGIN (second factor) or ENROLL (platform admin must enrol first).
model MfaChallenge {
  id            String    @id @default(uuid(7)) @db.Uuid
  principalType String    @map("principal_type") @db.VarChar(16)
  principalId   String    @map("principal_id") @db.Uuid
  tenantId      String?   @map("tenant_id") @db.Uuid
  purpose       String    @db.VarChar(16)
  tokenHash     String    @unique @map("token_hash") @db.VarChar(64)
  attempts      Int       @default(0)
  expiresAt     DateTime  @map("expires_at") @db.Timestamptz(6)
  consumedAt    DateTime? @map("consumed_at") @db.Timestamptz(6)
  createdAt     DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  tenant        Tenant?   @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([expiresAt])
  @@map("mfa_challenges")
}

/// ADR 053: tenant-defined label attached to persons and leads.
model Tag {
  id         String    @id @default(uuid(7)) @db.Uuid
  tenantId   String    @map("tenant_id") @db.Uuid
  name       String    @db.VarChar(40)
  /// Palette token: gray|blue|green|amber|red|purple (validated in API).
  color      String?   @db.VarChar(16)
  createdAt  DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  archivedAt DateTime? @map("archived_at") @db.Timestamptz(6)
  tenant     Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  personTags PersonTag[]
  leadTags   LeadTag[]

  @@unique([tenantId, id])
  // Active-name uniqueness is partial (lower(name), archived_at IS NULL) in
  // migration SQL; Prisma cannot express it (see 20261120090000 migration).
  @@index([tenantId, archivedAt])
  @@map("tags")
}

model PersonTag {
  tenantId  String   @map("tenant_id") @db.Uuid
  personId  String   @map("person_id") @db.Uuid
  tagId     String   @map("tag_id") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  tenant    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  person    Person   @relation(fields: [tenantId, personId], references: [tenantId, id], onDelete: Restrict)
  tag       Tag      @relation(fields: [tenantId, tagId], references: [tenantId, id], onDelete: Cascade)

  @@id([tenantId, personId, tagId])
  @@index([tenantId, tagId])
  @@map("person_tags")
}

model LeadTag {
  tenantId  String   @map("tenant_id") @db.Uuid
  leadId    String   @map("lead_id") @db.Uuid
  tagId     String   @map("tag_id") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  tenant    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  lead      Lead     @relation(fields: [tenantId, leadId], references: [tenantId, id], onDelete: Restrict)
  tag       Tag      @relation(fields: [tenantId, tagId], references: [tenantId, id], onDelete: Cascade)

  @@id([tenantId, leadId, tagId])
  @@index([tenantId, tagId])
  @@map("lead_tags")
}

/// ADR 053: tenant-defined custom field on Person or Lead.
model CustomFieldDef {
  id         String            @id @default(uuid(7)) @db.Uuid
  tenantId   String            @map("tenant_id") @db.Uuid
  entity     CustomFieldEntity
  /// Immutable slug ^[a-z][a-z0-9_]{0,39}$.
  key        String            @db.VarChar(40)
  label      String            @db.VarChar(80)
  type       CustomFieldType
  /// SELECT only: array of 1..50 unique option strings (1..60 chars).
  options    Json?             @db.JsonB
  position   Int               @default(0)
  createdAt  DateTime          @default(now()) @map("created_at") @db.Timestamptz(6)
  archivedAt DateTime?         @map("archived_at") @db.Timestamptz(6)
  tenant     Tenant            @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, id])
  @@unique([tenantId, entity, key])
  @@index([tenantId, entity, archivedAt, position])
  @@map("custom_field_defs")
}

/// ADR 064: a price list uploaded as a spreadsheet (one per tenant for now),
/// served by the `spreadsheet` connector. Cells are untrusted text.
model SheetCatalog {
  id             String   @id @default(uuid(7)) @db.Uuid
  tenantId       String   @map("tenant_id") @db.Uuid
  name           String   @db.VarChar(120)
  sourceFilename String?  @map("source_filename") @db.VarChar(200)
  /// Field -> column index chosen by the admin.
  mapping        Json     @default("{}")
  /// defaultCurrency, limitedThreshold, defaultAvailability.
  options        Json     @default("{}")
  /// Prices older than this are not quoted (ADR 064 decision 5).
  freshnessDays  Int      @default(3) @map("freshness_days")
  uploadedAt     DateTime @map("uploaded_at") @db.Timestamptz(6)
  rowCount       Int      @map("row_count")
  acceptedCount  Int      @map("accepted_count")
  rejectedCount  Int      @map("rejected_count")
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)
  tenant         Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  items          SheetCatalogItem[]
  offers         SheetCatalogOffer[]

  @@unique([tenantId, id])
  @@unique([tenantId])
  @@map("sheet_catalogs")
}

model SheetCatalogItem {
  tenantId        String   @map("tenant_id") @db.Uuid
  catalogId       String   @map("catalog_id") @db.Uuid
  key             String   @db.VarChar(32)
  title           String   @db.VarChar(500)
  normalizedTitle String   @map("normalized_title") @db.VarChar(600)
  itemType        String   @map("item_type") @db.VarChar(100)
  attributes      Json     @default("{}")
  catalog         SheetCatalog @relation(fields: [tenantId, catalogId], references: [tenantId, id], onDelete: Cascade)

  @@id([tenantId, catalogId, key])
  @@index([tenantId, catalogId, normalizedTitle])
  @@map("sheet_catalog_items")
}

model SheetCatalogOffer {
  tenantId     String   @map("tenant_id") @db.Uuid
  catalogId    String   @map("catalog_id") @db.Uuid
  key          String   @db.VarChar(200)
  itemKey      String   @map("item_key") @db.VarChar(32)
  price        Decimal  @db.Decimal(20, 6)
  currency     String   @db.Char(3)
  /// AVAILABLE | LIMITED | SOLD_OUT | UNKNOWN
  availability String   @db.VarChar(16)
  seatsLeft    Int?     @map("seats_left")
  startsOn     DateTime? @map("starts_on") @db.Date
  endsOn       DateTime? @map("ends_on") @db.Date
  attributes   Json     @default("{}")
  line         Int
  catalog      SheetCatalog @relation(fields: [tenantId, catalogId], references: [tenantId, id], onDelete: Cascade)

  @@id([tenantId, catalogId, key])
  @@index([tenantId, catalogId, itemKey])
  @@map("sheet_catalog_offers")
}
