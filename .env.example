# Environment consumed by apps/api (copy to .env at the repository root).
NODE_ENV=development
PORT=4000
# LOGIN_RATE_LIMIT_PER_MINUTE=20  # web inbox login attempts per address
# INBOX_STREAM_MAX_MS=900000  # SSE streams are recycled after this long
# WEB_ORIGINS=http://localhost:3000  # browser origins allowed to make inbox requests
# SESSION_COOKIE_SECURE=false  # only for plain-http local development; refused in production
# API_HOST=127.0.0.1  # default 0.0.0.0; bind to localhost for local tests
LOG_LEVEL=info
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DATABASE=agentcore
POSTGRES_USER=agentcore
POSTGRES_PASSWORD=agentcore
# Local Compose development is unencrypted. Set require or verify-full for remote PostgreSQL.
POSTGRES_SSL_MODE=disable
REDIS_URL=redis://localhost:6379
# Optional single-bot Phase 2 setup. Configure all three values together.
# TELEGRAM_CHANNEL_ACCOUNT_ID=<active channel_accounts.id UUID>
# TELEGRAM_BOT_TOKEN=<bot token from BotFather>
# TELEGRAM_WEBHOOK_SECRET=<setWebhook secret_token>
TELEGRAM_RATE_LIMIT_PER_MINUTE=120
# CRM connector outbound policy: strict (default, required in production) or
# permissive (private/loopback destinations and plain http, development only).
CONNECTOR_OUTBOUND_POLICY=strict
# Connector credentials are referenced from tenant config as
# env:CONNECTOR_SECRET_<NAME>; no other environment variable is reachable.
# CONNECTOR_SECRET_EXAMPLE_CRM_TOKEN=<token>
# Catalog sync: schedule interval (0 disables), stale-run recovery, size cap.
CATALOG_SYNC_INTERVAL_MINUTES=60
CATALOG_SYNC_STALE_AFTER_SECONDS=300
CATALOG_SYNC_MAX_ITEMS=5000
# LLM provider: mock (offline, deterministic; default) or anthropic (Claude API,
# billable). A configured key is not a verified connection: run the opt-in live
# eval (pnpm --filter @agentcore/api eval:live with LIVE_EVAL=1) to verify it.
# A Claude/ChatGPT subscription does not include API credits.
LLM_PROVIDER=mock
# openai-compatible (Gemini via its OpenAI endpoint, local Ollama, ...): see
# README presets. Keys belong in .env.local only.
# LLM_BASE_URL=<https://.../v1 or http://localhost:11434/v1>
# LLM_API_KEY=<optional; never commit>
# LLM_MODEL_FAST=<model id>
# LLM_MODEL_STRONG=<model id>
# LLM_STRUCTURED_OUTPUT=json_schema
# LLM_MAX_TOKENS_PARAM=max_tokens
# Client-side limits (set from your account's quota, e.g. AI Studio):
# LLM_RATE_LIMIT_RPM=<n>
# LLM_RATE_LIMIT_TPM=<n>
# LLM_RATE_LIMIT_RPD=<n>
# LLM_RATE_LIMIT_MAX_WAIT_MS=5000
# Data protection: only these providers may see real customer data.
# Failover router (LLM_PROVIDER=routed): needs LLM_PRICING_VERSION=routing-free-2026-10-23,
# the key variables named by the presets (GROQ_API_KEY, GEMINI_API_KEY, OPEN_ROUTER_API_KEY,
# MISTRAL_API_KEY, LLM7_API_KEY; put values in .env.local only) and optionally
# LLM_ROUTING_POLICY_FILE=<path to a routing policy JSON>.
LLM_TRUSTED_PROVIDERS=mock
LLM_ALLOW_REAL_CUSTOMER_DATA=false
# ANTHROPIC_API_KEY=<Claude API key; never commit, never store in the database>
LLM_FAST_MODEL=claude-haiku-5-5
LLM_STRONG_MODEL=claude-haiku-5-5
LLM_EFFORT=low
LLM_PRICING_VERSION=anthropic-2026-10-23
LLM_REQUEST_TIMEOUT_MS=20000
LLM_MAX_RETRIES=2
# Provisional limits (not owner-approved commercial budgets); see
# docs/LLM_PROVIDER_EVALUATION.md.
LLM_MAX_OUTPUT_TOKENS=1024
LLM_MAX_INPUT_BYTES=48000
LLM_MAX_CALLS_PER_TURN=6
LLM_MAX_TOOL_ROUNDS=3
LLM_MAX_TOOL_CALLS_PER_TURN=6
LLM_TURN_BUDGET_USD=0.02
LLM_CONVERSATION_BUDGET_USD=0.25
# Token caps (bound zero-priced models too).
LLM_TURN_TOKEN_BUDGET=120000
LLM_CONVERSATION_TOKEN_BUDGET=1000000
# LLM_TENANT_MONTHLY_BUDGET_USD=<optional monthly cap per tenant, e.g. 50>
AGENT_TOOL_TIMEOUT_MS=8000
AGENT_HISTORY_MESSAGES=8
# Whole-turn deadline; the lease must exceed it by at least 10 s so a live
# turn is never taken over by another worker.
AGENT_TURN_TIMEOUT_MS=60000
AGENT_TURN_LEASE_MS=120000
# Agent mode is per channel account (OFF | SHADOW | LIVE, default OFF), set
# with `pnpm --filter @agentcore/api agent:mode <channel-account-uuid> shadow`.
# LIVE is refused outside NODE_ENV=development until Phase 5.
# Live evaluation (opt-in, billable) reads ANTHROPIC_API_KEY from
# .env.local (gitignored); see README. LIVE_EVAL=1 LIVE_EVAL_BUDGET_USD=0.50
# Separate integration-test database. The test setup refuses other database names.
TEST_POSTGRES_HOST=localhost
TEST_POSTGRES_PORT=5432
TEST_POSTGRES_DATABASE=agentcore_test
TEST_POSTGRES_USER=agentcore
TEST_POSTGRES_PASSWORD=agentcore
TEST_POSTGRES_SSL_MODE=disable
# Phase 5 handover. Operator notifications go to the Telegram group stored in
# channel_accounts.operator_chat_id (the bot must be a member; register the
# webhook with allowed_updates ["message","callback_query"]).
HANDOVER_SLA_MINUTES=10
HANDOVER_SCAN_SECONDS=30
STUCK_REPEAT_LIMIT=2
# Phase 6 follow-ups to customers who went silent after the bot spoke. Off by
# default; honours /stop, consent and Telegram blocks; quiet hours are local
# to the tenant's time zone.
FOLLOWUP_ENABLED=false
FOLLOWUP_AFTER_HOURS=24
FOLLOWUP_MAX_PER_CONVERSATION=1
FOLLOWUP_QUIET_START_HOUR=21
FOLLOWUP_QUIET_END_HOUR=9
DIGEST_HOUR=9
# Phase 6 knowledge (RAG over textual knowledge; never prices or availability).
# Off by default. The embedder sees customer questions, so it follows the same
# data-protection rule as the chat providers (trusted provider, test account,
# or LLM_ALLOW_REAL_CUSTOMER_DATA=true). A model name is always required.
KNOWLEDGE_EMBEDDINGS=off
# KNOWLEDGE_EMBEDDING_MODEL=
# KNOWLEDGE_EMBEDDING_BASE_URL=
FOLLOWUP_MAX_PER_TENANT_PER_DAY=200
DIGEST_ENABLED=false
