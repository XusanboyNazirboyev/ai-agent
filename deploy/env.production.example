# Names only (ADR 035). On the host this file is rendered as
# deploy/.env.production from SSM Parameter Store; it is never committed.
NODE_ENV=production
SESSION_COOKIE_SECURE=true
# https://<domain>; the browser origin of the web app.
WEB_ORIGINS=
# https://<domain>; messenger webhooks are built from it.
PUBLIC_BASE_URL=
# 32+ random characters; the same value reaches the web container.
WEB_PROXY_SECRET=
# 32 bytes, base64; encrypts channel and connector secrets. Back it up: lost = secrets unreadable.
SECRETS_MASTER_KEY=
# RDS PostgreSQL (pgvector). Staging with docker-compose.local-db.yml (ADR 035
# amendment 2): POSTGRES_HOST=postgres and POSTGRES_SSL_MODE=disable.
POSTGRES_HOST=
POSTGRES_PORT=5432
POSTGRES_DATABASE=
POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_SSL_MODE=verify-full
# LLM provider settings, as in .env.example (keys from SSM, never inline).
LLM_PROVIDER=
# Voice notes (ADR 042): transcribed with the paid GEMINI_API_KEY (or STT_API_KEY).
# STT_PROVIDER=gemini
# GEMINI_API_KEY=<paid-tier key from SSM>
# Optional channels: Telegram and Instagram settings, as in .env.example.
# Instagram (ADR 031, "Instagram API with Instagram login" in the Meta app).
# Webhook callback URL in Meta: https://<host>/webhooks/instagram (field: messages).
# INSTAGRAM_APP_ID=<Meta App ID, Settings > Basic (Unified login; not an Instagram app ID)>
# INSTAGRAM_APP_SECRET=<Meta App Secret, Settings > Basic; also verifies webhooks; never commit>
# INSTAGRAM_VERIFY_TOKEN=<random, e.g. openssl rand -hex 24; the same value in Meta>
# INSTAGRAM_OAUTH_REDIRECT_URI=https://<host>/channels/instagram/callback
# INSTAGRAM_LOGIN_CONFIG_ID=<Configuration ID of "Instagram API (Unified Login)"; required for one-click connect>
# FACEBOOK_LOGIN_CONFIG_ID=<Messenger Facebook Login for Business configuration id>
# FACEBOOK_OAUTH_REDIRECT_URI=https://<host>/channels/facebook/callback
