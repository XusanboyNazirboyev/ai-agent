{
  "name": "agentcore-workspace",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@10.33.3",
  "engines": {
    "node": ">=20.19.0",
    "pnpm": ">=10"
  },
  "scripts": {
    "dev": "pnpm --filter @agentcore/api dev",
    "build": "pnpm --filter @agentcore/shared build && pnpm --filter @agentcore/api build",
    "lint": "pnpm --filter @agentcore/api lint && pnpm --filter @agentcore/shared lint",
    "format": "pnpm --filter @agentcore/api format && pnpm --filter @agentcore/shared format",
    "format:check": "pnpm --filter @agentcore/api format:check && pnpm --filter @agentcore/shared format:check",
    "typecheck": "pnpm --filter @agentcore/shared build && pnpm --filter @agentcore/api typecheck",
    "test": "pnpm --filter @agentcore/shared build && pnpm --filter @agentcore/api test",
    "test:coverage": "pnpm --filter @agentcore/shared build && pnpm --filter @agentcore/api test:coverage"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@vitest/coverage-v8": "^4.1.3",
    "eslint": "^10.13.0",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^16.5.0",
    "prettier": "^3.6.2",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.46.4",
    "vitest": "^4.1.3"
  }
}
